<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
<!-- Start of Shoplift scripts -->
{% render 'shoplift' %}
<!-- End of Shoplift scripts -->

  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">

  <title>
    {{ page_title }}{% if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif %}{% if current_page != 1 %} &ndash; Page {{ current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}
  </title>

  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}

  <link rel="canonical" href="{{ canonical_url }}">

  {% if settings.favicon != blank %}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {% endif %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Orbitron:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

  {{ 'base.css' | asset_url | stylesheet_tag }}

  {{ content_for_header }}

  <style>
    :root {
      --color-bg: {{ settings.color_background }};
      --color-bg-card: {{ settings.color_card_background }};
      --color-text: {{ settings.color_text }};
      --color-text-muted: {{ settings.color_text_muted }};
      --color-accent: {{ settings.color_accent }};
      --color-accent-secondary: {{ settings.color_accent_secondary }};
      --color-success: {{ settings.color_success }};
      --color-danger: {{ settings.color_danger }};
      --font-heading: 'Orbitron', sans-serif;
      --font-body: 'Inter', sans-serif;
    }
  </style>
</head>
<body class="template-{{ template.name }}{% if template.suffix %} template-{{ template.name }}-{{ template.suffix }}{% endif %}">
  <a class="skip-to-content" href="#MainContent">{{ 'general.accessibility.skip_to_content' | t }}</a>

  {% sections 'header-group' %}

  <main id="MainContent" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  {% if settings.cart_type == 'drawer' %}
  <div class="cart-drawer-overlay" id="cart-drawer-overlay" onclick="document.getElementById('cart-drawer-overlay').classList.remove('is-open'); document.getElementById('cart-drawer').classList.remove('is-open'); document.body.style.overflow='';"></div>
  <div class="cart-drawer" id="cart-drawer">
    <div class="cart-drawer-header">
      <h2>Your Cart</h2>
      <button class="cart-drawer-close" aria-label="Close cart" onclick="document.getElementById('cart-drawer-overlay').classList.remove('is-open'); document.getElementById('cart-drawer').classList.remove('is-open'); document.body.style.overflow='';">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="cart-drawer-items">
      {% if cart.item_count == 0 %}
        <p style="color: var(--color-text-muted); text-align: center; padding: 40px 0;">Your cart is empty</p>
      {% else %}
        {% for item in cart.items %}
        <div style="display:flex; gap:14px; padding:14px 0; border-bottom:1px solid rgba(255,255,255,0.04);">
          {% if item.image %}
          <img src="{{ item.image | image_url: width: 80 }}" alt="{{ item.title }}" style="width:60px; height:60px; object-fit:cover; border-radius:8px;">
          {% endif %}
          <div style="flex:1;">
            <div style="font-weight:600; font-size:0.9rem;">{{ item.product.title }}</div>
            <div style="color:var(--color-text-muted); font-size:0.8rem;">Qty: {{ item.quantity }}</div>
            <div style="font-weight:700; font-size:0.9rem; margin-top:4px;">{{ item.final_line_price | money }}</div>
          </div>
        </div>
        {% endfor %}
      {% endif %}
    </div>
    <div class="cart-drawer-footer">
      {% if cart.item_count > 0 %}
      <div style="display:flex; justify-content:space-between; margin-bottom:14px; font-size:0.95rem;">
        <span>Subtotal</span>
        <span style="font-weight:700;">{{ cart.total_price | money }}</span>
      </div>
      {% endif %}
      <a href="/checkout" class="btn btn-primary" style="width:100%; text-align:center;">{% if cart.item_count > 0 %}Checkout{% else %}Continue Shopping{% endif %}</a>
    </div>
  </div>
  {% endif %}

  <script>
    document.documentElement.classList.remove('no-js');
    document.documentElement.classList.add('js');
  </script>
</body>
</html>
