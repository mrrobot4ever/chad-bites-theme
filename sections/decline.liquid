<section class="decline-section" data-section-id="{{ section.id }}">
  <div class="decline-bg">
    {% if section.settings.background_image != blank %}
      <img src="{{ section.settings.background_image | image_url: width: 1920 }}" alt="" loading="lazy" class="decline-bg-img">
    {% endif %}
    <div class="decline-bg-gradient"></div>
  </div>
  <div class="decline-inner">
    <h2 class="decline-heading">{{ section.settings.heading_line1 }}<br><span class="decline-heading-accent">{{ section.settings.heading_line2 }}</span></h2>

    <div class="decline-body">
      <div class="decline-chart-col">
        {% if section.settings.chart_image != blank %}
          <img src="{{ section.settings.chart_image | image_url: width: 800 }}" alt="{{ section.settings.chart_alt }}" loading="lazy">
        {% else %}
          <img src="{{ 'decline-chart.png' | asset_url }}" alt="Testosterone levels with Chad Bites" loading="lazy">
        {% endif %}
      </div>

      <div class="decline-text-col">
        {% if section.settings.paragraph_1 != blank %}
          <div class="decline-para">{{ section.settings.paragraph_1 }}</div>
        {% else %}
          <p class="decline-para"><strong>Testosterone levels</strong> have been dropping by 1% every year since 1980. Stress, poor sleep, processed diets, and toxins are destroying natural hormone production.</p>
        {% endif %}
        {% if section.settings.paragraph_2 != blank %}
          <div class="decline-para">{{ section.settings.paragraph_2 }}</div>
        {% else %}
          <p class="decline-para">The impact? Low testosterone drains energy, strength, and focus&mdash;making it harder to perform at your best in life and the gym.</p>
        {% endif %}
        {% if section.settings.paragraph_3 != blank %}
          <div class="decline-para">{{ section.settings.paragraph_3 }}</div>
        {% else %}
          <p class="decline-para"><strong>The good news:</strong> Chad Bites helps you reclaim your edge with natural testosterone support for energy, focus, and strength.</p>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Decline of T",
  "class": "decline-section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading_line1",
      "label": "Heading line 1",
      "default": "THE DECLINE OF T:"
    },
    {
      "type": "text",
      "id": "heading_line2",
      "label": "Heading line 2 (accent)",
      "default": "A MODERN EPIDEMIC"
    },
    {
      "type": "image_picker",
      "id": "chart_image",
      "label": "Chart image"
    },
    {
      "type": "text",
      "id": "chart_alt",
      "label": "Chart image alt text",
      "default": "Testosterone levels with Chad Bites"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "richtext",
      "id": "paragraph_1",
      "label": "Paragraph 1",
      "default": "<p><strong>Testosterone levels</strong> have been dropping by 1% every year since 1980. Stress, poor sleep, processed diets, and toxins are destroying natural hormone production.</p>"
    },
    {
      "type": "richtext",
      "id": "paragraph_2",
      "label": "Paragraph 2",
      "default": "<p>The impact? Low testosterone drains energy, strength, and focus—making it harder to perform at your best in life and the gym.</p>"
    },
    {
      "type": "richtext",
      "id": "paragraph_3",
      "label": "Paragraph 3",
      "default": "<p><strong>The good news:</strong> Chad Bites helps you reclaim your edge with natural testosterone support for energy, focus, and strength.</p>"
    }
  ],
  "presets": [
    {
      "name": "Decline of T"
    }
  ]
}
{% endschema %}
