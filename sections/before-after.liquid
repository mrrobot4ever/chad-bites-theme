<section class="before-after-section section-padding" data-section-id="{{ section.id }}">
  <div class="container">
    <div class="ba-card">
      <div class="ba-column ba-before">
        <div class="ba-column-header">{{ section.settings.before_heading }}</div>
        {% for block in section.blocks %}
          {% if block.type == 'before_item' %}
            <div class="ba-item" {{ block.shopify_attributes }}>
              <span class="ba-icon ba-icon--x">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
              </span>
              <span>{{ block.settings.text }}</span>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <div class="ba-center-image">
        {% if section.settings.center_image != blank %}
          <img src="{{ section.settings.center_image | image_url: width: 400 }}" alt="Transformation" loading="lazy">
        {% else %}
          <img src="{{ 'before-after-man.jpg' | asset_url }}" alt="Transformation" loading="lazy">
        {% endif %}
      </div>

      <div class="ba-column ba-after">
        <div class="ba-column-header">{{ section.settings.after_heading }}</div>
        {% for block in section.blocks %}
          {% if block.type == 'after_item' %}
            <div class="ba-item" {{ block.shopify_attributes }}>
              <span class="ba-icon ba-icon--check">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              </span>
              <span>{{ block.settings.text }}</span>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Before / After",
  "class": "before-after-section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "before_heading",
      "label": "Before column heading",
      "default": "BEFORE"
    },
    {
      "type": "text",
      "id": "after_heading",
      "label": "After column heading",
      "default": "AFTER"
    },
    {
      "type": "image_picker",
      "id": "center_image",
      "label": "Center image"
    }
  ],
  "blocks": [
    {
      "type": "before_item",
      "name": "Before item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Low energy"
        }
      ]
    },
    {
      "type": "after_item",
      "name": "After item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Sustained energy"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Before / After",
      "blocks": [
        { "type": "before_item", "settings": { "text": "Low energy" } },
        { "type": "before_item", "settings": { "text": "No motivation" } },
        { "type": "before_item", "settings": { "text": "Slower recovery" } },
        { "type": "before_item", "settings": { "text": "Brain fog" } },
        { "type": "before_item", "settings": { "text": "Low drive" } },
        { "type": "before_item", "settings": { "text": "Just getting by" } },
        { "type": "after_item", "settings": { "text": "Sustained energy" } },
        { "type": "after_item", "settings": { "text": "Clear focus" } },
        { "type": "after_item", "settings": { "text": "Stronger performance" } },
        { "type": "after_item", "settings": { "text": "Better recovery" } },
        { "type": "after_item", "settings": { "text": "High drive" } },
        { "type": "after_item", "settings": { "text": "Living with purpose" } }
      ]
    }
  ]
}
{% endschema %}
