{% assign has_blocks = false %}
{% if section.blocks.size > 0 %}
  {% assign has_blocks = true %}
{% endif %}

<section class="solution-section" data-section-id="{{ section.id }}">
  <div class="solution-bg"></div>
  <div class="solution-inner">
    <h2 class="solution-heading">{{ section.settings.heading | default: "CHAD BITES - THE FAST AND EASY WAY TO INCREASE YOUR T" }}</h2>
    <p class="solution-subtext">{{ section.settings.subtext | default: "Pro Athletes Have Been Using This Stack for Years Because They Can't Touch TRT. Now It's in a Blackberry Gummy" }}</p>

    <div class="solution-body">
      <div class="solution-benefits-col">
        <div class="solution-benefits-card">
          {% if has_blocks %}
            {% for block in section.blocks %}
              <div class="solution-benefit" {{ block.shopify_attributes }}>
                <span class="solution-benefit-icon">&#x2713;</span>
                <div class="solution-benefit-text">
                  <h3 class="solution-benefit-title">{{ block.settings.title }}</h3>
                  <p class="solution-benefit-desc">{{ block.settings.description }}</p>
                </div>
              </div>
            {% endfor %}
          {% else %}
            <div class="solution-benefit">
              <span class="solution-benefit-icon">&#x2713;</span>
              <div class="solution-benefit-text">
                <h3 class="solution-benefit-title">Skyrocket Energy & Stamina</h3>
                <p class="solution-benefit-desc">Increase energy & athletic performance</p>
              </div>
            </div>
            <div class="solution-benefit">
              <span class="solution-benefit-icon">&#x2713;</span>
              <div class="solution-benefit-text">
                <h3 class="solution-benefit-title">Support Male Vitality</h3>
                <p class="solution-benefit-desc">Amplify passionate energy</p>
              </div>
            </div>
            <div class="solution-benefit">
              <span class="solution-benefit-icon">&#x2713;</span>
              <div class="solution-benefit-text">
                <h3 class="solution-benefit-title">Enhance Productivity & Focus</h3>
                <p class="solution-benefit-desc">Stay sharp & focused all day</p>
              </div>
            </div>
            <div class="solution-benefit">
              <span class="solution-benefit-icon">&#x2713;</span>
              <div class="solution-benefit-text">
                <h3 class="solution-benefit-title">Supercharge Strength</h3>
                <p class="solution-benefit-desc">Build & maintain lean muscle mass</p>
              </div>
            </div>
            <div class="solution-benefit">
              <span class="solution-benefit-icon">&#x2713;</span>
              <div class="solution-benefit-text">
                <h3 class="solution-benefit-title">Improve Recovery</h3>
                <p class="solution-benefit-desc">Optimize sleep & muscle recovery</p>
              </div>
            </div>
          {% endif %}
        </div>
      </div>

      <div class="solution-product-col">
        {% if section.settings.product_image != blank %}
          <img src="{{ section.settings.product_image | image_url: width: 800 }}" alt="Chad Bites product" loading="lazy" class="solution-product-img">
        {% else %}
          <div class="solution-product-placeholder">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          </div>
        {% endif %}
        <a href="{{ section.settings.cta_url | default: '#' }}" class="btn btn-primary btn-lg solution-cta">
          {{ section.settings.cta_text | default: "GET 1 BOTTLE FREE" }}
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
        </a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "The Solution",
  "class": "solution-section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "CHAD BITES - THE FAST AND EASY WAY TO INCREASE YOUR T"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Pro Athletes Have Been Using This Stack for Years Because They Can't Touch TRT. Now It's in a Blackberry Gummy"
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product image"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button text",
      "default": "GET 1 BOTTLE FREE"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Benefit title",
          "default": "Benefit Title"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Benefit description",
          "default": "Benefit description text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "The Solution",
      "blocks": [
        { "type": "benefit", "settings": { "title": "Skyrocket Energy & Stamina", "description": "Increase energy & athletic performance" } },
        { "type": "benefit", "settings": { "title": "Support Male Vitality", "description": "Amplify passionate energy" } },
        { "type": "benefit", "settings": { "title": "Enhance Productivity & Focus", "description": "Stay sharp & focused all day" } },
        { "type": "benefit", "settings": { "title": "Supercharge Strength", "description": "Build & maintain lean muscle mass" } },
        { "type": "benefit", "settings": { "title": "Improve Recovery", "description": "Optimize sleep & muscle recovery" } }
      ]
    }
  ]
}
{% endschema %}
