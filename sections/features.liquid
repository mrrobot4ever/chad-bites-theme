<section class="features-section section-padding" data-section-id="{{ section.id }}">
  <div class="container">
    <div class="features-grid">
      {% for block in section.blocks %}
        {% if block.type == 'feature' %}
          <div class="feature-card glass-card" {{ block.shopify_attributes }}>
            <div class="feature-icon">
              {% case block.settings.icon %}
                {% when 'ritual' %}
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                {% when 'taste' %}
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                {% when 'nocrash' %}
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                {% when 'science' %}
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>
                {% else %}
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              {% endcase %}
            </div>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.description }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Features",
  "class": "features-section-wrapper",
  "settings": [],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Feature"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Short description of this feature."
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "ritual", "label": "Daily Ritual (clock)" },
            { "value": "taste", "label": "Delicious Taste (smile)" },
            { "value": "nocrash", "label": "No Crash (lightning)" },
            { "value": "science", "label": "Backed by Science (beaker)" }
          ],
          "default": "ritual"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Features",
      "blocks": [
        { "type": "feature", "settings": { "title": "Daily Ritual", "description": "Two gummies a day. That's it. Simple enough to never miss, powerful enough to feel the difference.", "icon": "ritual" } },
        { "type": "feature", "settings": { "title": "Delicious Taste", "description": "Mixed berry flavor that you'll actually look forward to. No chalky pills or bitter powders.", "icon": "taste" } },
        { "type": "feature", "settings": { "title": "No Crash", "description": "Clean, sustained energy without the jitters or afternoon crash. Just steady performance all day.", "icon": "nocrash" } },
        { "type": "feature", "settings": { "title": "Backed by Science", "description": "Every ingredient is clinically studied and dosed at effective levels. No pixie-dusting.", "icon": "science" } }
      ]
    }
  ]
}
{% endschema %}
