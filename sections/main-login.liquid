<section class="customer-section section-padding">
  <div class="container">
    <div class="customer-form">
      <h1>{{ 'customer.login.title' | t }}</h1>

      {% form 'customer_login' %}
        {% if form.errors %}
          <div class="form-errors">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <div class="form-group">
          <label for="CustomerEmail">{{ 'customer.login.email' | t }}</label>
          <input type="email" name="customer[email]" id="CustomerEmail" class="form-input" autocomplete="email" autocorrect="off" autocapitalize="off" required>
        </div>

        <div class="form-group">
          <label for="CustomerPassword">{{ 'customer.login.password' | t }}</label>
          <input type="password" name="customer[password]" id="CustomerPassword" class="form-input" autocomplete="current-password" required>
        </div>

        <button type="submit" class="btn btn-primary form-submit">{{ 'customer.login.sign_in' | t }}</button>

        <div class="form-link">
          <a href="/account/register">{{ 'customer.login.create_account' | t }}</a>
        </div>
        <div class="form-link">
          <a href="#recover">{{ 'customer.login.forgot_password' | t }}</a>
        </div>
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Customer login",
  "settings": []
}
{% endschema %}
