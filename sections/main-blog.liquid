<section class="blog-section section-padding" style="padding-top:96px;">
  <div class="container">
    <h1 class="section-heading text-center">{{ blog.title }}</h1>

    {% if blog.articles.size > 0 %}
      <div class="blog-grid">
        {% for article in blog.articles %}
          <a href="{{ article.url }}" class="blog-card">
            {% if article.image %}
              <div class="blog-card-img">
                <img src="{{ article.image | image_url: width: 600 }}" alt="{{ article.title | escape }}" loading="lazy">
              </div>
            {% endif %}
            <div class="blog-card-body">
              <h2 class="blog-card-title">{{ article.title }}</h2>
              <p class="blog-card-meta">{{ article.published_at | date: "%B %d, %Y" }}</p>
              <p class="blog-card-excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 30 }}</p>
            </div>
          </a>
        {% endfor %}
      </div>

      {% if blog.articles.size > blog.articles_count %}
        <div class="blog-pagination text-center" style="margin-top:32px;">
          {{ paginate | default_pagination }}
        </div>
      {% endif %}
    {% else %}
      <p class="text-center" style="color:var(--color-text-muted);padding:40px 0;">No articles yet.</p>
    {% endif %}
  </div>
</section>

<style>
  .blog-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    margin-top: 32px;
  }
  @media (min-width: 640px) {
    .blog-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .blog-grid { grid-template-columns: repeat(3, 1fr); }
  }
  .blog-card {
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 12px;
    overflow: hidden;
    transition: border-color 0.2s, transform 0.2s;
    text-decoration: none;
    color: var(--color-text);
    display: block;
  }
  .blog-card:hover {
    border-color: rgba(77,124,254,0.2);
    transform: translateY(-2px);
  }
  .blog-card-img { overflow: hidden; }
  .blog-card-img img { width: 100%; height: 200px; object-fit: cover; display: block; }
  .blog-card-body { padding: 20px; }
  .blog-card-title {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 8px;
    line-height: 1.3;
  }
  .blog-card-meta {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    margin-bottom: 10px;
  }
  .blog-card-excerpt {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }
</style>

{% schema %}
{
  "name": "Blog listing",
  "class": "blog-section-wrapper",
  "settings": []
}
{% endschema %}
