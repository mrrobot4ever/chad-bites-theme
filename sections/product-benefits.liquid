<section class="benefits-section section-padding" data-section-id="{{ section.id }}">
  <div class="container">
    <div class="benefits-layout">
      <div class="benefits-text-side">
        <h2 class="section-heading">{{ section.settings.heading }}</h2>
        {% if section.settings.subtext != blank %}
          <p class="benefits-desc">{{ section.settings.subtext }}</p>
        {% endif %}

        <div class="benefits-icons-row">
          {% for block in section.blocks %}
            {% if block.type == 'benefit' %}
              <div class="benefit-inline" {{ block.shopify_attributes }}>
                <div class="benefit-inline-icon">
                  {% case block.settings.icon %}
                    {% when 'testosterone' %}
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
                    {% when 'energy' %}
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                    {% when 'strength' %}
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    {% when 'vitality' %}
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
                    {% else %}
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                  {% endcase %}
                </div>
                <div class="benefit-inline-text">
                  <strong>{{ block.settings.title | upcase }}</strong>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>

      <div class="benefits-product-side">
        <div class="benefits-product-wrap">
          <div class="benefits-badges-float">
            {% for block in section.blocks %}
              {% if block.type == 'badge' %}
                <div class="benefit-badge" {{ block.shopify_attributes }}>
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                  <span>{{ block.settings.text }}</span>
                </div>
              {% endif %}
            {% endfor %}
          </div>

          {% if section.settings.product_image != blank %}
            <img src="{{ section.settings.product_image | image_url: width: 500 }}" alt="{{ section.settings.heading }}" loading="lazy" class="benefits-product-img">
          {% else %}
            <img src="{{ 'pouch-front.jpg' | asset_url }}" alt="Chad Bites" loading="lazy" class="benefits-product-img">
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Benefits",
  "class": "benefits-section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "THE FUTURE OF MALE PERFORMANCE"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Description",
      "default": "Test Boost Gummies are expertly formulated with premium ingredients to support healthy testosterone levels, energy, muscle strength, drive, and overall vitality—naturally."
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product image"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product (fallback for image)"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Badge text",
          "default": "Clinically Studied"
        }
      ]
    },
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Benefit"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Description of the benefit."
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "testosterone", "label": "Testosterone (trending up)" },
            { "value": "energy", "label": "Energy (lightning)" },
            { "value": "strength", "label": "Strength (globe)" },
            { "value": "vitality", "label": "Vitality (heart)" }
          ],
          "default": "testosterone"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Benefits",
      "blocks": [
        { "type": "badge", "settings": { "text": "Clinically Studied Ingredients" } },
        { "type": "badge", "settings": { "text": "Third-Party Tested" } },
        { "type": "badge", "settings": { "text": "Premium Formula" } },
        { "type": "badge", "settings": { "text": "Delicious Mixed Berry" } },
        { "type": "benefit", "settings": { "title": "Supports Testosterone", "description": "Key ingredients like Tongkat Ali and KSM-66 Ashwagandha shown to support healthy testosterone levels in clinical studies.", "icon": "testosterone" } },
        { "type": "benefit", "settings": { "title": "Supports Energy & Drive", "description": "B-vitamins, Zinc, and adaptogenic herbs work together to fuel sustained energy without the crash.", "icon": "energy" } },
        { "type": "benefit", "settings": { "title": "Supports Strength", "description": "Vitamin D3 and Boron support muscle function, bone density, and overall physical performance.", "icon": "strength" } },
        { "type": "benefit", "settings": { "title": "Supports Vitality", "description": "A comprehensive formula designed to support the pillars of male health and daily vitality.", "icon": "vitality" } }
      ]
    }
  ]
}
{% endschema %}
