{% assign has_product_blocks = false %}
{% assign has_link_blocks = false %}
{% for block in section.blocks %}
  {% if block.type == 'product_card' %}{% assign has_product_blocks = true %}{% endif %}
  {% if block.type == 'nav_link' %}{% assign has_link_blocks = true %}{% endif %}
{% endfor %}

<header class="site-header" data-section-id="{{ section.id }}">
  <div class="header-inner">
    <button class="hamburger" aria-label="Menu" aria-expanded="false" onclick="document.querySelector('.mobile-menu').classList.toggle('is-open'); this.classList.toggle('is-open'); this.closest('.site-header').classList.toggle('menu-open'); this.setAttribute('aria-expanded', this.getAttribute('aria-expanded') === 'true' ? 'false' : 'true');">
      <span></span>
      <span></span>
      <span></span>
    </button>

    <a href="/" class="header-logo">
      {% if settings.logo != blank %}
        <img src="{{ settings.logo | image_url: width: settings.logo_width }}"
             alt="{{ shop.name }}"
             width="{{ settings.logo_width }}"
             height="{{ settings.logo_width | divided_by: 2 }}"
             loading="eager">
      {% else %}
        <span class="header-logo-text">{{ section.settings.logo_text_1 | default: "chad" }}<span>{{ section.settings.logo_text_2 | default: "bites" }}</span></span>
      {% endif %}
    </a>

    <a href="/cart" class="header-cart-btn" aria-label="Cart" {% if settings.cart_type == 'drawer' %}onclick="event.preventDefault(); document.getElementById('cart-drawer-overlay').classList.add('is-open'); document.getElementById('cart-drawer').classList.add('is-open'); document.body.style.overflow='hidden';"{% endif %}>
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
        <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
      </svg>
      <span class="header-cart-count">{{ cart.item_count }}</span>
    </a>
  </div>

  <nav class="mobile-menu" aria-label="Mobile navigation">
    <div class="mobile-menu-inner">

      <p class="menu-tagline"><span class="menu-tagline-accent">{{ section.settings.tagline_accent | default: "Get Your Edge Back," }}</span> {{ section.settings.tagline_rest | default: "Naturally" }}</p>

      <div class="menu-body">
        <div class="menu-products">
          {% if has_product_blocks %}
            {% for block in section.blocks %}
              {% if block.type == 'product_card' %}
                <a href="{{ block.settings.url | default: '#' }}" class="menu-product-card" {{ block.shopify_attributes }}>
                  <div class="menu-product-img">
                    {% if block.settings.image != blank %}
                      <img src="{{ block.settings.image | image_url: width: 200 }}" alt="{{ block.settings.name }}" style="width:100%;height:100%;object-fit:cover;border-radius:12px;">
                    {% else %}
                      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.2"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
                    {% endif %}
                  </div>
                  <div class="menu-product-text">
                    <span class="menu-product-name">{{ block.settings.name }}</span>
                    <span class="menu-product-sub">{{ block.settings.subtitle }}</span>
                  </div>
                </a>
              {% endif %}
            {% endfor %}
          {% else %}
            <a href="#" class="menu-product-card">
              <div class="menu-product-img">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.2"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
              </div>
              <div class="menu-product-text">
                <span class="menu-product-name">Test Max Gummies</span>
                <span class="menu-product-sub">Testosterone Support</span>
              </div>
            </a>
            <a href="#" class="menu-product-card">
              <div class="menu-product-img">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.2"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
              </div>
              <div class="menu-product-text">
                <span class="menu-product-name">Pump Max Gummies</span>
                <span class="menu-product-sub">Blood Flow & Performance</span>
              </div>
            </a>
            <a href="#" class="menu-product-card">
              <div class="menu-product-img">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.2"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
              </div>
              <div class="menu-product-text">
                <span class="menu-product-name">Prosti Max Gummies</span>
                <span class="menu-product-sub">Prostate Health</span>
              </div>
            </a>
            <a href="#" class="menu-product-card">
              <div class="menu-product-img">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.2"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
              </div>
              <div class="menu-product-text">
                <span class="menu-product-name">Brain Max Gummies</span>
                <span class="menu-product-sub">Focus & Cognitive Support</span>
              </div>
            </a>
          {% endif %}
        </div>

        <div class="menu-links">
          {% if has_link_blocks %}
            {% for block in section.blocks %}
              {% if block.type == 'nav_link' %}
                <a href="{{ block.settings.url | default: '#' }}" class="menu-link" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
              {% endif %}
            {% endfor %}
          {% else %}
            <a href="#" class="menu-link">Our Story</a>
            <a href="#" class="menu-link">Reviews</a>
            <a href="#" class="menu-link">FAQ</a>
            <a href="#" class="menu-link">Contact</a>
            <a href="#" class="menu-link">Manage Subscription</a>
            <a href="#" class="menu-link">Affiliates</a>
          {% endif %}
        </div>
      </div>

    </div>
  </nav>
</header>

{% schema %}
{
  "name": "Header",
  "class": "header-section",
  "settings": [
    {
      "type": "text",
      "id": "logo_text_1",
      "label": "Logo text (part 1)",
      "default": "chad"
    },
    {
      "type": "text",
      "id": "logo_text_2",
      "label": "Logo text (part 2 - accent)",
      "default": "bites"
    },
    {
      "type": "text",
      "id": "tagline_accent",
      "label": "Tagline accent text",
      "default": "Get Your Edge Back,"
    },
    {
      "type": "text",
      "id": "tagline_rest",
      "label": "Tagline rest",
      "default": "Naturally"
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product card",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Product name",
          "default": "Product"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Description"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Product image"
        }
      ]
    },
    {
      "type": "nav_link",
      "name": "Navigation link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Link"
        },
        {
          "type": "url",
          "id": "url",
          "label": "URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Header",
      "blocks": [
        { "type": "product_card", "settings": { "name": "Test Max Gummies", "subtitle": "Testosterone Support" } },
        { "type": "product_card", "settings": { "name": "Pump Max Gummies", "subtitle": "Blood Flow & Performance" } },
        { "type": "product_card", "settings": { "name": "Prosti Max Gummies", "subtitle": "Prostate Health" } },
        { "type": "product_card", "settings": { "name": "Brain Max Gummies", "subtitle": "Focus & Cognitive Support" } },
        { "type": "nav_link", "settings": { "label": "Our Story" } },
        { "type": "nav_link", "settings": { "label": "Reviews" } },
        { "type": "nav_link", "settings": { "label": "FAQ" } },
        { "type": "nav_link", "settings": { "label": "Contact" } },
        { "type": "nav_link", "settings": { "label": "Manage Subscription" } },
        { "type": "nav_link", "settings": { "label": "Affiliates" } }
      ]
    }
  ]
}
{% endschema %}
