<header class="site-header" data-section-id="{{ section.id }}">
  <div class="header-inner">
    <button class="hamburger" aria-label="Menu" aria-expanded="false" onclick="document.querySelector('.mobile-menu').classList.toggle('is-open'); this.classList.toggle('is-open'); this.closest('.site-header').classList.toggle('menu-open'); this.setAttribute('aria-expanded', this.getAttribute('aria-expanded') === 'true' ? 'false' : 'true');">
      <span></span>
      <span></span>
      <span></span>
    </button>

    <a href="/" class="header-logo">
      {% if settings.logo != blank %}
        <img src="{{ settings.logo | image_url: width: settings.logo_width }}"
             alt="{{ shop.name }}"
             width="{{ settings.logo_width }}"
             height="{{ settings.logo_width | divided_by: 2 }}"
             loading="eager">
      {% else %}
        <span class="header-logo-text">{{ section.settings.logo_text_1 | default: "chad" }}<span>{{ section.settings.logo_text_2 | default: "bites" }}</span></span>
      {% endif %}
    </a>

    <a href="/cart" class="header-cart-btn" aria-label="Cart" {% if settings.cart_type == 'drawer' %}onclick="event.preventDefault(); document.getElementById('cart-drawer-overlay').classList.add('is-open'); document.getElementById('cart-drawer').classList.add('is-open'); document.body.style.overflow='hidden';"{% endif %}>
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
        <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
      </svg>
      <span class="header-cart-count">{{ cart.item_count }}</span>
    </a>
  </div>

  <nav class="mobile-menu" aria-label="Mobile navigation">
    <div class="mobile-menu-inner">

      <p class="menu-tagline"><span class="menu-tagline-accent">{{ section.settings.tagline_accent | default: "Get Your Edge Back," }}</span> {{ section.settings.tagline_rest | default: "Naturally" }}</p>

      <div class="menu-body">
        <div class="menu-products">
          <a href="{{ section.settings.prod1_url | default: '#' }}" class="menu-product-card">
            <div class="menu-product-img">
              {% if section.settings.prod1_image != blank %}
                <img src="{{ section.settings.prod1_image | image_url: width: 200 }}" alt="{{ section.settings.prod1_name }}" style="width:100%;height:100%;object-fit:cover;border-radius:12px;">
              {% else %}
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.2"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
              {% endif %}
            </div>
            <div class="menu-product-text">
              <span class="menu-product-name">{{ section.settings.prod1_name | default: "Test Max Gummies" }}</span>
              <span class="menu-product-sub">{{ section.settings.prod1_sub | default: "Testosterone Support" }}</span>
            </div>
          </a>
          <a href="{{ section.settings.prod2_url | default: '#' }}" class="menu-product-card">
            <div class="menu-product-img">
              {% if section.settings.prod2_image != blank %}
                <img src="{{ section.settings.prod2_image | image_url: width: 200 }}" alt="{{ section.settings.prod2_name }}" style="width:100%;height:100%;object-fit:cover;border-radius:12px;">
              {% else %}
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.2"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
              {% endif %}
            </div>
            <div class="menu-product-text">
              <span class="menu-product-name">{{ section.settings.prod2_name | default: "Pump Max Gummies" }}</span>
              <span class="menu-product-sub">{{ section.settings.prod2_sub | default: "Blood Flow & Performance" }}</span>
            </div>
          </a>
          <a href="{{ section.settings.prod3_url | default: '#' }}" class="menu-product-card">
            <div class="menu-product-img">
              {% if section.settings.prod3_image != blank %}
                <img src="{{ section.settings.prod3_image | image_url: width: 200 }}" alt="{{ section.settings.prod3_name }}" style="width:100%;height:100%;object-fit:cover;border-radius:12px;">
              {% else %}
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.2"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
              {% endif %}
            </div>
            <div class="menu-product-text">
              <span class="menu-product-name">{{ section.settings.prod3_name | default: "Prosti Max Gummies" }}</span>
              <span class="menu-product-sub">{{ section.settings.prod3_sub | default: "Prostate Health" }}</span>
            </div>
          </a>
          <a href="{{ section.settings.prod4_url | default: '#' }}" class="menu-product-card">
            <div class="menu-product-img">
              {% if section.settings.prod4_image != blank %}
                <img src="{{ section.settings.prod4_image | image_url: width: 200 }}" alt="{{ section.settings.prod4_name }}" style="width:100%;height:100%;object-fit:cover;border-radius:12px;">
              {% else %}
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.2"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
              {% endif %}
            </div>
            <div class="menu-product-text">
              <span class="menu-product-name">{{ section.settings.prod4_name | default: "Brain Max Gummies" }}</span>
              <span class="menu-product-sub">{{ section.settings.prod4_sub | default: "Focus & Cognitive Support" }}</span>
            </div>
          </a>
        </div>

        <div class="menu-links">
          <a href="{{ section.settings.link1_url | default: '#' }}" class="menu-link">{{ section.settings.link1_text | default: "Our Story" }}</a>
          <a href="{{ section.settings.link2_url | default: '#' }}" class="menu-link">{{ section.settings.link2_text | default: "Reviews" }}</a>
          <a href="{{ section.settings.link3_url | default: '#' }}" class="menu-link">{{ section.settings.link3_text | default: "FAQ" }}</a>
          <a href="{{ section.settings.link4_url | default: '#' }}" class="menu-link">{{ section.settings.link4_text | default: "Contact" }}</a>
          <a href="{{ section.settings.link5_url | default: '#' }}" class="menu-link">{{ section.settings.link5_text | default: "Manage Subscription" }}</a>
          <a href="{{ section.settings.link6_url | default: '#' }}" class="menu-link">{{ section.settings.link6_text | default: "Affiliates" }}</a>
        </div>
      </div>

    </div>
  </nav>
</header>

{% schema %}
{
  "name": "Header",
  "class": "header-section",
  "settings": [
    { "type": "header", "content": "Logo" },
    { "type": "text", "id": "logo_text_1", "label": "Logo text (part 1)", "default": "chad" },
    { "type": "text", "id": "logo_text_2", "label": "Logo text (part 2 - accent)", "default": "bites" },
    { "type": "header", "content": "Tagline" },
    { "type": "text", "id": "tagline_accent", "label": "Tagline accent text", "default": "Get Your Edge Back," },
    { "type": "text", "id": "tagline_rest", "label": "Tagline rest", "default": "Naturally" },
    { "type": "header", "content": "Product 1" },
    { "type": "text", "id": "prod1_name", "label": "Name", "default": "Test Max Gummies" },
    { "type": "text", "id": "prod1_sub", "label": "Subtitle", "default": "Testosterone Support" },
    { "type": "url", "id": "prod1_url", "label": "Link" },
    { "type": "image_picker", "id": "prod1_image", "label": "Image" },
    { "type": "header", "content": "Product 2" },
    { "type": "text", "id": "prod2_name", "label": "Name", "default": "Pump Max Gummies" },
    { "type": "text", "id": "prod2_sub", "label": "Subtitle", "default": "Blood Flow & Performance" },
    { "type": "url", "id": "prod2_url", "label": "Link" },
    { "type": "image_picker", "id": "prod2_image", "label": "Image" },
    { "type": "header", "content": "Product 3" },
    { "type": "text", "id": "prod3_name", "label": "Name", "default": "Prosti Max Gummies" },
    { "type": "text", "id": "prod3_sub", "label": "Subtitle", "default": "Prostate Health" },
    { "type": "url", "id": "prod3_url", "label": "Link" },
    { "type": "image_picker", "id": "prod3_image", "label": "Image" },
    { "type": "header", "content": "Product 4" },
    { "type": "text", "id": "prod4_name", "label": "Name", "default": "Brain Max Gummies" },
    { "type": "text", "id": "prod4_sub", "label": "Subtitle", "default": "Focus & Cognitive Support" },
    { "type": "url", "id": "prod4_url", "label": "Link" },
    { "type": "image_picker", "id": "prod4_image", "label": "Image" },
    { "type": "header", "content": "Nav Link 1" },
    { "type": "text", "id": "link1_text", "label": "Text", "default": "Our Story" },
    { "type": "url", "id": "link1_url", "label": "URL" },
    { "type": "header", "content": "Nav Link 2" },
    { "type": "text", "id": "link2_text", "label": "Text", "default": "Reviews" },
    { "type": "url", "id": "link2_url", "label": "URL" },
    { "type": "header", "content": "Nav Link 3" },
    { "type": "text", "id": "link3_text", "label": "Text", "default": "FAQ" },
    { "type": "url", "id": "link3_url", "label": "URL" },
    { "type": "header", "content": "Nav Link 4" },
    { "type": "text", "id": "link4_text", "label": "Text", "default": "Contact" },
    { "type": "url", "id": "link4_url", "label": "URL" },
    { "type": "header", "content": "Nav Link 5" },
    { "type": "text", "id": "link5_text", "label": "Text", "default": "Manage Subscription" },
    { "type": "url", "id": "link5_url", "label": "URL" },
    { "type": "header", "content": "Nav Link 6" },
    { "type": "text", "id": "link6_text", "label": "Text", "default": "Affiliates" },
    { "type": "url", "id": "link6_url", "label": "URL" }
  ]
}
{% endschema %}
