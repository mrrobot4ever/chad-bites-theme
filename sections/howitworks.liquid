{% assign has_blocks = false %}
{% if section.blocks.size > 0 %}
  {% assign has_blocks = true %}
{% endif %}

<section class="hiw-section" data-section-id="{{ section.id }}">
  <div class="hiw-bg">
    {% if section.settings.background_image != blank %}
      <img src="{{ section.settings.background_image | image_url: width: 1920 }}" alt="" loading="lazy">
    {% else %}
      <img src="{{ 'howitworks-bg.jpg' | asset_url }}" alt="" loading="lazy">
    {% endif %}
    <div class="hiw-bg-overlay"></div>
  </div>

  <div class="hiw-inner">
    <h2 class="hiw-heading">{{ section.settings.heading | default: "HOW DOES CHAD BITES WORK?" }}</h2>
    <p class="hiw-subtext">{{ section.settings.subtext | default: "Maximize your testosterone level naturally, quickly, and easily." }}</p>

    <div class="hiw-timeline">
      <div class="hiw-timeline-line"></div>

      {% if has_blocks %}
        {% for block in section.blocks %}
          <div class="hiw-stage" {{ block.shopify_attributes }}>
            <div class="hiw-stage-dot"></div>
            <div class="hiw-stage-header">
              <span class="hiw-stage-day">{{ block.settings.day_label }}</span>
              <span class="hiw-stage-name">{{ block.settings.stage_name }}</span>
            </div>
            <ul class="hiw-stage-bullets">
              {% if block.settings.bullet_1 != blank %}<li>{{ block.settings.bullet_1 }}</li>{% endif %}
              {% if block.settings.bullet_2 != blank %}<li>{{ block.settings.bullet_2 }}</li>{% endif %}
              {% if block.settings.bullet_3 != blank %}<li>{{ block.settings.bullet_3 }}</li>{% endif %}
              {% if block.settings.bullet_4 != blank %}<li>{{ block.settings.bullet_4 }}</li>{% endif %}
            </ul>
          </div>
        {% endfor %}
      {% else %}
        <div class="hiw-stage">
          <div class="hiw-stage-dot"></div>
          <div class="hiw-stage-header">
            <span class="hiw-stage-day">DAY 7</span>
            <span class="hiw-stage-name">ACTIVATE</span>
          </div>
          <ul class="hiw-stage-bullets">
            <li>Tongkat Ali blocks stress hormones</li>
            <li>Fulvic Acid feeds starving testosterone cells</li>
            <li>Workouts feel intense again</li>
            <li>Start to feel that all-day energy</li>
          </ul>
        </div>
        <div class="hiw-stage">
          <div class="hiw-stage-dot"></div>
          <div class="hiw-stage-header">
            <span class="hiw-stage-day">DAY 30</span>
            <span class="hiw-stage-name">DOMINATE</span>
          </div>
          <ul class="hiw-stage-bullets">
            <li>Boron helps free stuck T</li>
            <li>Zinc provides T-making materials</li>
            <li>Body looks leaner, stronger, more masculine</li>
            <li>People ask what you're doing differently</li>
          </ul>
        </div>
        <div class="hiw-stage">
          <div class="hiw-stage-dot"></div>
          <div class="hiw-stage-header">
            <span class="hiw-stage-day">DAY 90</span>
            <span class="hiw-stage-name">UNSTOPPABLE</span>
          </div>
          <ul class="hiw-stage-bullets">
            <li>All 8 ingredients working like a tuned engine</li>
            <li>T-production optimized fully</li>
            <li>Not temporary, this is your new normal</li>
            <li>Welcome to the man you're supposed to be</li>
          </ul>
        </div>
      {% endif %}
    </div>

    <div class="hiw-cta-wrap">
      <a href="{{ section.settings.cta_url | default: '#' }}" class="btn btn-primary btn-lg">
        {{ section.settings.cta_text | default: "GET 1 BOTTLE FREE" }}
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "How It Works",
  "class": "hiw-section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "HOW DOES CHAD BITES WORK?"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Maximize your testosterone level naturally, quickly, and easily."
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button text",
      "default": "GET 1 BOTTLE FREE"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "stage",
      "name": "Timeline stage",
      "settings": [
        {
          "type": "text",
          "id": "day_label",
          "label": "Day label",
          "default": "DAY 7"
        },
        {
          "type": "text",
          "id": "stage_name",
          "label": "Stage name",
          "default": "ACTIVATE"
        },
        {
          "type": "text",
          "id": "bullet_1",
          "label": "Bullet 1"
        },
        {
          "type": "text",
          "id": "bullet_2",
          "label": "Bullet 2"
        },
        {
          "type": "text",
          "id": "bullet_3",
          "label": "Bullet 3"
        },
        {
          "type": "text",
          "id": "bullet_4",
          "label": "Bullet 4"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "How It Works",
      "blocks": [
        { "type": "stage", "settings": { "day_label": "DAY 7", "stage_name": "ACTIVATE", "bullet_1": "Tongkat Ali blocks stress hormones", "bullet_2": "Fulvic Acid feeds starving testosterone cells", "bullet_3": "Workouts feel intense again", "bullet_4": "Start to feel that all-day energy" } },
        { "type": "stage", "settings": { "day_label": "DAY 30", "stage_name": "DOMINATE", "bullet_1": "Boron helps free stuck T", "bullet_2": "Zinc provides T-making materials", "bullet_3": "Body looks leaner, stronger, more masculine", "bullet_4": "People ask what you're doing differently" } },
        { "type": "stage", "settings": { "day_label": "DAY 90", "stage_name": "UNSTOPPABLE", "bullet_1": "All 8 ingredients working like a tuned engine", "bullet_2": "T-production optimized fully", "bullet_3": "Not temporary, this is your new normal", "bullet_4": "Welcome to the man you're supposed to be" } }
      ]
    }
  ]
}
{% endschema %}
