<section class="riskfree-section" data-section-id="{{ section.id }}">
  <div class="riskfree-bg">
    {% if section.settings.background_image != blank %}
      <img src="{{ section.settings.background_image | image_url: width: 1920 }}" alt="" loading="lazy">
    {% else %}
      <img src="{{ 'riskfree-bg.jpg' | asset_url }}" alt="" loading="lazy">
    {% endif %}
    <div class="riskfree-bg-overlay"></div>
  </div>

  <div class="riskfree-inner">
    <div class="riskfree-content">
      <div class="riskfree-text-col">
        <h2 class="riskfree-heading">{{ section.settings.heading_line1 | default: "ZERO RISK." }}<br><span class="riskfree-heading-accent">{{ section.settings.heading_line2 | default: "ALL REWARD." }}</span></h2>
        <p class="riskfree-body">{{ section.settings.body_text | default: "Try Chad Bites for 365 days. If you don't feel your edge return—if you don't see real, measurable changes in your energy, drive, physique, and confidence—we refund your last order. No questions asked. No hoops to jump through." }}</p>
        <a href="{{ section.settings.cta_url | default: '#' }}" class="btn btn-primary btn-lg riskfree-cta">
          {{ section.settings.cta_text | default: "GET 1 BOTTLE FREE" }}
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
        </a>
      </div>

      <div class="riskfree-badge-col">
        {% if section.settings.badge_image != blank %}
          <img src="{{ section.settings.badge_image | image_url: width: 200 }}" alt="Guarantee badge" class="riskfree-badge-img">
        {% else %}
          <div class="riskfree-badge">
            <svg class="riskfree-badge-icon" xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            <span class="riskfree-badge-top">{{ section.settings.badge_top_text | default: "90 DAY" }}</span>
            <span class="riskfree-badge-bottom">{{ section.settings.badge_bottom_text | default: "HIGHER T GUARANTEE" }}</span>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Risk Free",
  "class": "riskfree-section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading_line1",
      "label": "Heading line 1",
      "default": "ZERO RISK."
    },
    {
      "type": "text",
      "id": "heading_line2",
      "label": "Heading line 2 (accent)",
      "default": "ALL REWARD."
    },
    {
      "type": "textarea",
      "id": "body_text",
      "label": "Body text",
      "default": "Try Chad Bites for 365 days. If you don't feel your edge return—if you don't see real, measurable changes in your energy, drive, physique, and confidence—we refund your last order. No questions asked. No hoops to jump through."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button text",
      "default": "GET 1 BOTTLE FREE"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "image_picker",
      "id": "badge_image",
      "label": "Badge image (optional, overrides default badge)"
    },
    {
      "type": "text",
      "id": "badge_top_text",
      "label": "Badge top text",
      "default": "90 DAY"
    },
    {
      "type": "text",
      "id": "badge_bottom_text",
      "label": "Badge bottom text",
      "default": "HIGHER T GUARANTEE"
    }
  ],
  "presets": [
    {
      "name": "Risk Free"
    }
  ]
}
{% endschema %}
