<section class="product-section section-padding" data-section-id="{{ section.id }}">
  <div class="container">
    {% assign current_variant = product.selected_or_first_available_variant %}

    <div class="product-layout">
      <div class="product-gallery">
        <div class="product-carousel">
          <div class="product-carousel-main">
            {% assign product_images = product.media | where: "media_type", "image" %}
            {% if product_images.size > 0 %}
              {% for media_item in product_images %}
              {% assign image = media_item %}
                <div class="product-carousel-slide{% if forloop.first %} active{% endif %}" data-index="{{ forloop.index0 }}">
                  <img src="{{ image.preview_image | image_url: width: 1000 }}"
                       alt="{{ image.alt | escape | default: product.title }}"
                       loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
                </div>
              {% endfor %}
            {% else %}
              <div class="product-carousel-slide active">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
          {% if product_images.size > 1 %}
            {% if section.settings.show_arrows %}<button class="product-carousel-arrow product-carousel-prev" onclick="carouselNav(-1)" aria-label="Previous image">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
            </button>
            <button class="product-carousel-arrow product-carousel-next" onclick="carouselNav(1)" aria-label="Next image">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
            </button>{% endif %}
            {% comment %}thumbnails removed{% endcomment %}{% if false %}<div>
              {% for media_item in product_images %}
              {% assign image = media_item %}
                <div class="product-carousel-thumb{% if forloop.first %} active{% endif %}" onclick="carouselGo({{ forloop.index0 }})" aria-label="View image {{ forloop.index }}">
                  <img src="{{ image.preview_image | image_url: width: 200 }}" alt="{{ image.alt | escape | default: product.title }}" style="width:70px !important;height:70px !important;object-fit:cover !important;display:block !important;position:absolute;top:0;left:0;">
                </div>
              {% endfor %}
            </div>{% endif %}
          {% endif %}
        </div>
      </div>

      <div class="product-info">
        <h1 class="product-title">{{ product.title }}</h1>

        <div class="product-price" id="ProductPrice-{{ section.id }}">
          <span id="ProductPriceValue-{{ section.id }}">{{ current_variant.price | money }}</span>
          {% if current_variant.compare_at_price > current_variant.price %}
            <span class="compare-price" id="ProductComparePrice-{{ section.id }}">{{ current_variant.compare_at_price | money }}</span>
          {% endif %}
        </div>

        {% if product.description != blank %}
          <div class="product-description">{{ product.description }}</div>
        {% endif %}

        {% form 'product', product, id: 'product-form' %}
          {% if product.has_only_default_variant == false %}
            {% for option in product.options_with_values %}
              <div class="product-form-group">
                <label>{{ option.name }}</label>
                <div class="variant-selector">
                  {% for value in option.values %}
                    <button type="button"
                            class="variant-option{% if option.selected_value == value %} selected{% endif %}"
                            data-option-index="{{ forloop.parentloop.index0 }}"
                            data-value="{{ value | escape }}">
                      {{ value }}
                    </button>
                  {% endfor %}
                </div>
              </div>
            {% endfor %}
          {% endif %}

          <div class="product-form-group">
            <label>{{ 'products.product.quantity' | t }}</label>
            <div class="quantity-selector">
              <button type="button" class="quantity-btn" onclick="var i=this.parentNode.querySelector('input');i.value=Math.max(1,parseInt(i.value)-1);">−</button>
              <input type="number" name="quantity" value="1" min="1" class="quantity-input" aria-label="Quantity">
              <button type="button" class="quantity-btn" onclick="var i=this.parentNode.querySelector('input');i.value=parseInt(i.value)+1;">+</button>
            </div>
          </div>

          <select name="id" id="ProductSelect-{{ section.id }}" style="display: none;">
            {% for variant in product.variants %}
              <option value="{{ variant.id }}"
                      {% if variant == current_variant %}selected{% endif %}
                      {% unless variant.available %}disabled{% endunless %}
                      data-price="{{ variant.price | money }}"
                      data-compare-price="{{ variant.compare_at_price | money }}">
                {{ variant.title }} — {{ variant.price | money }}
              </option>
            {% endfor %}
          </select>

          <button type="submit" name="add"
                  class="btn btn-primary btn-lg add-to-cart-btn"
                  {% unless current_variant.available %}disabled{% endunless %}>
            {% if current_variant.available %}
              {{ 'products.product.add_to_cart' | t }}
            {% else %}
              {{ 'products.product.sold_out' | t }}
            {% endif %}
          </button>
        <div class="product-app-blocks">
          {% for block in section.blocks %}
            {% case block.type %}
              {% when '@app' %}
                {% render block %}
            {% endcase %}
          {% endfor %}
        </div>

        {% endform %}

        <div class="product-meta">
          <div class="product-meta-item">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/></svg>
            {{ section.settings.meta_shipping }}
          </div>
          <div class="product-meta-item">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            {{ section.settings.meta_guarantee }}
          </div>
          <div class="product-meta-item">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            {{ section.settings.meta_tested }}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (function() {
    var section = document.querySelector('[data-section-id="{{ section.id }}"]');
    if (!section) return;

    var variantButtons = section.querySelectorAll('.variant-option');
    var select = section.querySelector('#ProductSelect-{{ section.id }}');
    var product = {{ product | json }};

    variantButtons.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var group = btn.parentNode;
        group.querySelectorAll('.variant-option').forEach(function(b) { b.classList.remove('selected'); });
        btn.classList.add('selected');

        var selectedOptions = [];
        section.querySelectorAll('.variant-selector').forEach(function(selector) {
          var selected = selector.querySelector('.variant-option.selected');
          if (selected) selectedOptions.push(selected.getAttribute('data-value'));
        });

        var variantTitle = selectedOptions.join(' / ');
        for (var i = 0; i < product.variants.length; i++) {
          if (product.variants[i].title === variantTitle) {
            select.value = product.variants[i].id;
            var priceEl = section.querySelector('#ProductPriceValue-{{ section.id }}');
            if (priceEl) priceEl.textContent = Shopify.formatMoney ? Shopify.formatMoney(product.variants[i].price) : '$' + (product.variants[i].price / 100).toFixed(2);
            var addBtn = section.querySelector('.add-to-cart-btn');
            if (product.variants[i].available) {
              addBtn.disabled = false;
              addBtn.textContent = '{{ "products.product.add_to_cart" | t }}';
            } else {
              addBtn.disabled = true;
              addBtn.textContent = '{{ "products.product.sold_out" | t }}';
            }
            break;
          }
        }
      });
    });
  })();
</script>


<script>
  (function() {
    var form = document.getElementById('product-form');
    if (!form) return;
    form.addEventListener('submit', function(e) {
      if ('{{ settings.cart_type }}' !== 'drawer') return;
      e.preventDefault();
      var btn = form.querySelector('.add-to-cart-btn');
      var origText = btn.textContent;
      btn.disabled = true;
      btn.textContent = 'Adding...';
      var formData = new FormData(form);
      fetch('/cart/add.js', {
        method: 'POST',
        body: formData
      })
      .then(function(r) { return r.json(); })
      .then(function(item) {
        btn.textContent = 'Added!';
        setTimeout(function() {
          btn.disabled = false;
          btn.textContent = origText;
        }, 1500);
        fetch('/cart.js').then(function(r) { return r.json(); }).then(function(cart) {
          var countEl = document.getElementById('cart-count');
          if (countEl) countEl.textContent = cart.item_count;
          var overlay = document.getElementById('cart-drawer-overlay');
          var drawer = document.getElementById('cart-drawer');
          if (overlay && drawer) {
            updateCartDrawer(cart);
            overlay.classList.add('is-open');
            drawer.classList.add('is-open');
            document.body.style.overflow = 'hidden';
          }
        });
      })
      .catch(function() {
        btn.disabled = false;
        btn.textContent = origText;
      });
    });
  })();
</script>

<style>
  .product-carousel { position: relative; }
  .product-carousel-main { position: relative; overflow: hidden; border-radius: 12px; }
  .product-carousel-slide { display: none; }
  .product-carousel-slide.active { display: block; }
  .product-carousel-slide img { width: 100%; height: auto; display: block; }
  .product-carousel-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(0,0,0,0.5);
    border: none;
    color: #fff;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 2;
    transition: background 0.2s;
  }
  .product-carousel-arrow:hover { background: rgba(0,0,0,0.7); }
  .product-carousel-prev { left: 10px; }
  .product-carousel-next { right: 10px; }
  
</style>

<script>
  var carouselIndex = 0;
  function carouselGo(idx) {
    var slides = document.querySelectorAll('.product-carousel-slide');
    var thumbs = document.querySelectorAll('.product-carousel-thumb');
    if (idx < 0) idx = slides.length - 1;
    if (idx >= slides.length) idx = 0;
    slides.forEach(function(s) { s.classList.remove('active'); });
    thumbs.forEach(function(t) { t.classList.remove('active'); });
    slides[idx].classList.add('active');
    if (thumbs[idx]) thumbs[idx].classList.add('active');
    carouselIndex = idx;
  }
  function carouselNav(dir) { carouselGo(carouselIndex + dir); }
  setInterval(function() { carouselGo(carouselIndex + 1); }, 2500);
</script>

{% schema %}
{
  "name": "Product page",
  "settings": [
    {
      "type": "text",
      "id": "meta_shipping",
      "label": "Shipping meta text",
      "default": "Free shipping on orders $50+"
    },
    {
      "type": "text",
      "id": "meta_guarantee",
      "label": "Guarantee meta text",
      "default": "60-day money back guarantee"
    },
    {
      "type": "text",
      "id": "meta_tested",
      "label": "Testing meta text",
      "default": "Third-party tested"
    },
    
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show navigation arrows",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
