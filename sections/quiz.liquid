<section class="quiz-section" id="quiz-section" data-redirect-url="{{ section.settings.final_redirect_url | default: "#" }}">
  <div class="quiz-progress-bar">
    <div class="quiz-progress-fill" id="quizProgressFill"></div>
  </div>
  <div class="quiz-progress-text" id="quizProgressText">1 / 16</div>

  <div class="quiz-container">

    <!-- STEP 1: Intro/Warning -->
    <div class="quiz-step quiz-step--active" data-step="1">
      <h2 class="quiz-heading">{{ section.settings.step1_heading | default: "WARNING: THIS IS NOT ANOTHER SCAM TEST BOOSTER" }}</h2>
      <div class="quiz-circle-image">
        {% if section.settings.step1_image != blank %}
          <img src="{{ section.settings.step1_image | image_url: width: 400 }}" alt="">
        {% endif %}
      </div>
      <p class="quiz-body">{{ section.settings.step1_body | default: "Before we give you access to the most potent testosterone stack on earth - used by A list actors and professional athletes. We need to ask you some questions. You must be over 18 to continue." }}</p>
      <button class="quiz-btn quiz-btn--cta" onclick="quizNext(2)">{{ section.settings.step1_button | default: "Agree and Continue" }}</button>
    </div>

    <!-- STEP 2: Age -->
    <div class="quiz-step" data-step="2">
      <h2 class="quiz-heading">{{ section.settings.step2_question | default: "How old are you?" }}</h2>
      <p class="quiz-subtext">{{ section.settings.step2_subtext | default: "This 2-minute assessment analyzes your exact symptoms, lifestyle, and risk factor in order to see if Chad Bites will work for you." }}</p>
      <div class="quiz-options">
        {% assign step2_answers = section.settings.step2_answers | default: "50+ Years Old|40-49 Years Old|30-39 Years Old|20-29 Years Old" | split: "|" %}
        {% for answer in step2_answers %}
          <button class="quiz-option" onclick="quizSelectAnswer(2, {{ forloop.index0 }}, this)">{{ answer }}</button>
        {% endfor %}
      </div>
    </div>

    <!-- STEP 3: Biggest concern -->
    <div class="quiz-step" data-step="3">
      <h2 class="quiz-heading">{{ section.settings.step3_question | default: "What's your biggest concern about your masculine health right now?" }}</h2>
      <div class="quiz-options">
        {% assign step3_answers = section.settings.step3_answers | default: "Energy levels|Muscle mass and strength|Sex drive and performance|Mental focus and clarity|Weight loss" | split: "|" %}
        {% for answer in step3_answers %}
          <button class="quiz-option" onclick="quizSelectAnswer(3, {{ forloop.index0 }}, this)">{{ answer }}</button>
        {% endfor %}
      </div>
    </div>

    <!-- STEP 4: Stress -->
    <div class="quiz-step" data-step="4">
      <h2 class="quiz-heading">{{ section.settings.step4_question | default: "Do you have stress symptoms during the day? Like feeling tired, cranky, foggy, or moody." }}</h2>
      <div class="quiz-options">
        {% assign step4_answers = section.settings.step4_answers | default: "Yes|No" | split: "|" %}
        {% for answer in step4_answers %}
          <button class="quiz-option" onclick="quizSelectAnswer(4, {{ forloop.index0 }}, this)">{{ answer }}</button>
        {% endfor %}
      </div>
    </div>

    <!-- STEP 5: Energy at 3PM -->
    <div class="quiz-step" data-step="5">
      <h2 class="quiz-heading">{{ section.settings.step5_question | default: "HOW'S YOUR ENERGY AT 3PM COMPARED TO WHEN YOU WAKE UP?" }}</h2>
      <div class="quiz-options">
        {% assign step5_answers = section.settings.step5_answers | default: "Completely drained. I need caffeine or a nap|Noticeably lower - afternoon slump hits hard|Slightly tired - still functional but slower|Same energy - no afternoon crash" | split: "|" %}
        {% for answer in step5_answers %}
          <button class="quiz-option" onclick="quizSelectAnswer(5, {{ forloop.index0 }}, this)">{{ answer }}</button>
        {% endfor %}
      </div>
    </div>

    <!-- STEP 6: When changes noticed -->
    <div class="quiz-step" data-step="6">
      <h2 class="quiz-heading">{{ section.settings.step6_question | default: "WHEN DID YOU START NOTICING CHANGES TO YOUR ENERGY AND DRIVE?" }}</h2>
      <div class="quiz-options">
        {% assign step6_answers = section.settings.step6_answers | default: "Over a year ago|In the past year|In the past few months|Not sure" | split: "|" %}
        {% for answer in step6_answers %}
          <button class="quiz-option" onclick="quizSelectAnswer(6, {{ forloop.index0 }}, this)">{{ answer }}</button>
        {% endfor %}
      </div>
    </div>

    <!-- STEP 7: Expected results -->
    <div class="quiz-step" data-step="7">
      <h2 class="quiz-heading">{{ section.settings.step7_question | default: "WHAT RESULTS ARE YOU EXPECTING FROM INCREASED TESTOSTERONE?" }}</h2>
      <div class="quiz-options">
        {% assign step7_answers = section.settings.step7_answers | default: "Higher energy that lasts all day|Increased muscle mass and strength|Better sex drive and performance|Improved mental clarity and focus|All of the above" | split: "|" %}
        {% for answer in step7_answers %}
          <button class="quiz-option" onclick="quizSelectAnswer(7, {{ forloop.index0 }}, this)">{{ answer }}</button>
        {% endfor %}
      </div>
    </div>

    <!-- STEP 8: Congratulations -->
    <div class="quiz-step" data-step="8">
      <h2 class="quiz-heading">{{ section.settings.step8_heading | default: "CONGRATULATIONS. YOU ARE IN THE RIGHT PLACE." }}</h2>
      <p class="quiz-body">{{ section.settings.step8_body | default: "Over 29,576 men have reclaimed their T, drive, and physique thanks to our new scientific, natural T-revival system used by pro athletes and now made available to you." }}</p>
      <div class="quiz-square-image">
        {% if section.settings.step8_image != blank %}
          <img src="{{ section.settings.step8_image | image_url: width: 600 }}" alt="">
        {% endif %}
      </div>
      <button class="quiz-btn quiz-btn--cta" onclick="quizNext(9)">{{ section.settings.step8_button | default: "Continue" }}</button>
    </div>

    <!-- STEP 9: Body composition -->
    <div class="quiz-step" data-step="9">
      <h2 class="quiz-heading">{{ section.settings.step9_question | default: "HOW WOULD YOU DESCRIBE YOUR CURRENT BODY COMPOSITION?" }}</h2>
      <div class="quiz-options">
        {% assign step9_answers = section.settings.step9_answers | default: "Lean and muscular|Average build|Soft with some muscle|Overweight / out of shape" | split: "|" %}
        {% for answer in step9_answers %}
          <button class="quiz-option" onclick="quizSelectAnswer(9, {{ forloop.index0 }}, this)">{{ answer }}</button>
        {% endfor %}
      </div>
    </div>

    <!-- STEP 10: Sleep -->
    <div class="quiz-step" data-step="10">
      <h2 class="quiz-heading">{{ section.settings.step10_question | default: "HOW MANY HOURS OF QUALITY SLEEP DO YOU GET PER NIGHT?" }}</h2>
      <div class="quiz-options">
        {% assign step10_answers = section.settings.step10_answers | default: "Less than 5 hours|5–6 hours|7–8 hours|More than 8 hours" | split: "|" %}
        {% for answer in step10_answers %}
          <button class="quiz-option" onclick="quizSelectAnswer(10, {{ forloop.index0 }}, this)">{{ answer }}</button>
        {% endfor %}
      </div>
    </div>

    <!-- STEP 11: Analyzing animation -->
    <div class="quiz-step" data-step="11">
      <h2 class="quiz-heading">{{ section.settings.step11_heading | default: "ANALYZING YOUR HEALTH PROFILE…" }}</h2>
      <p class="quiz-subtext">{{ section.settings.step11_subtext | default: "Based on your responses, we're building a comprehensive assessment of your hormonal health and identifying the key factors affecting your energy and vitality." }}</p>
      <div class="quiz-analysis-bar-wrap">
        <div class="quiz-analysis-bar">
          <div class="quiz-analysis-bar-fill" id="analysisBarFill"></div>
        </div>
        <span class="quiz-analysis-label">{{ section.settings.step11_label | default: "ANALYZING" }}</span>
      </div>
    </div>

    <!-- STEP 12: Family history -->
    <div class="quiz-step" data-step="12">
      <h2 class="quiz-heading">{{ section.settings.step12_question | default: "DO YOU HAVE A FAMILY HISTORY OF DIABETES, HEART DISEASE, OR METABOLIC ISSUES?" }}</h2>
      <div class="quiz-info-box">
        <h4 class="quiz-info-heading">{{ section.settings.step12_info_heading | default: "WHY WE ASK" }}</h4>
        <p class="quiz-info-text">{{ section.settings.step12_info_text | default: "These conditions share similar root causes with low testosterone — insulin resistance, inflammation, and metabolic dysfunction. Family patterns help us identify your risk factors." }}</p>
      </div>
      <div class="quiz-options">
        {% assign step12_answers = section.settings.step12_answers | default: "Yes|No|Not sure" | split: "|" %}
        {% for answer in step12_answers %}
          <button class="quiz-option" onclick="quizSelectAnswer(12, {{ forloop.index0 }}, this)">{{ answer }}</button>
        {% endfor %}
      </div>
    </div>

    <!-- STEP 13: Processed foods -->
    <div class="quiz-step" data-step="13">
      <h2 class="quiz-heading">{{ section.settings.step13_question | default: "HOW OFTEN DO YOU EAT PROCESSED FOODS?" }}</h2>
      <div class="quiz-info-box">
        <h4 class="quiz-info-heading">{{ section.settings.step13_info_heading | default: "WHY WE ASK" }}</h4>
        <p class="quiz-info-text">{{ section.settings.step13_info_text | default: "Processed foods contain chemicals and additives that disrupt hormone production. Ultra-processed foods are linked to lower testosterone levels in multiple studies." }}</p>
      </div>
      <div class="quiz-options">
        {% assign step13_answers = section.settings.step13_answers | default: "Daily - most meals include processed foods|Several times a week|Occasionally - mostly whole foods|Rarely - I avoid processed foods" | split: "|" %}
        {% for answer in step13_answers %}
          <button class="quiz-option" onclick="quizSelectAnswer(13, {{ forloop.index0 }}, this)">{{ answer }}</button>
        {% endfor %}
      </div>
    </div>

    <!-- STEP 14: Building profile animation -->
    <div class="quiz-step" data-step="14">
      <h2 class="quiz-heading">{{ section.settings.step14_heading | default: "BUILDING YOUR PROFILE…" }}</h2>
      <p class="quiz-subtext">{{ section.settings.step14_subtext | default: "Hold tight while we map your answers against the Chad Bites Alpha-Male-revival framework." }}</p>
      <div class="quiz-checklist" id="quizChecklist">
        {% assign checklist_items = section.settings.step14_checklist | default: "Analyzing your symptoms|Cross-referencing your lifestyle|Calibrating your protocol|Personalizing your result" | split: "|" %}
        {% for item in checklist_items %}
          <div class="quiz-check-item" id="checkItem{{ forloop.index }}">
            <span class="quiz-check-icon">&#10003;</span>
            <span>{{ item }}</span>
          </div>
        {% endfor %}
      </div>
      <p class="quiz-ready-text" id="quizReadyText">{{ section.settings.step14_final | default: "YOUR PROTOCOL SUMMARY IS ALMOST READY" }}</p>
    </div>

    <!-- STEP 15: Results -->
    <div class="quiz-step" data-step="15">
      <h2 class="quiz-heading">{{ section.settings.step15_heading | default: "Your Testosterone Assessment:" }}</h2>
      <div class="quiz-result-label" id="resultDeclineLabel"></div>
      <p class="quiz-result-desc" id="resultDescription"></p>
      <div class="quiz-suppression-wrap">
        <span class="quiz-suppression-label">Level of T Suppression</span>
        <div class="quiz-suppression-bar">
          <div class="quiz-suppression-fill" id="resultSuppressionFill"></div>
        </div>
      </div>
      <div class="quiz-stat-grid">
        <div class="quiz-stat-card">
          <span class="quiz-stat-title">DECLINE PATTERN</span>
          <span class="quiz-stat-value" id="statDecline"></span>
        </div>
        <div class="quiz-stat-card">
          <span class="quiz-stat-title">PRIMARY ROOT CAUSE</span>
          <span class="quiz-stat-value" id="statPrimary"></span>
        </div>
        <div class="quiz-stat-card">
          <span class="quiz-stat-title">SECONDARY ROOT CAUSE</span>
          <span class="quiz-stat-value" id="statSecondary"></span>
        </div>
        <div class="quiz-stat-card">
          <span class="quiz-stat-title">QUALITY OF LIFE IMPACT</span>
          <span class="quiz-stat-value" id="statQuality"></span>
        </div>
      </div>
      <button class="quiz-btn quiz-btn--cta" onclick="quizNext(16)">{{ section.settings.step15_button | default: "SHOW ME WHAT'S POSSIBLE" }} &rarr;</button>
    </div>

    <!-- STEP 16: Final projection -->
    <div class="quiz-step" data-step="16"
      data-chart-status-label="{{ section.settings.chart_status_label | default: 'STATUS' }}"
      data-chart-projected-label="{{ section.settings.chart_projected_label | default: 'PROJECTED LIFT' }}"
      data-chart-eta-label="{{ section.settings.chart_eta_label | default: 'ETA' }}">
      <h2 class="quiz-heading">{{ section.settings.step16_heading | default: "THE LAST SOLUTION YOU'LL EVER NEED TO FEEL LIKE A MAN AGAIN." }}</h2>
      <p class="quiz-subtext" id="step16Subtext">{{ section.settings.step16_subtext_prefix | default: "Based on your answers, we expect you to visibly increase energy, strength and masculine drive by" }} <span id="step16Date"></span></p>
      <div class="quiz-chart-card">
        <div class="quiz-chart-stats">
          <div class="quiz-chart-stat">
            <span class="quiz-chart-stat-label">{{ section.settings.chart_status_label | default: "STATUS" }}</span>
            <span class="quiz-chart-stat-value" id="chartStatus"></span>
          </div>
          <div class="quiz-chart-stat">
            <span class="quiz-chart-stat-label">{{ section.settings.chart_projected_label | default: "PROJECTED LIFT" }}</span>
            <span class="quiz-chart-stat-value" id="chartLift"></span>
          </div>
          <div class="quiz-chart-stat">
            <span class="quiz-chart-stat-label">{{ section.settings.chart_eta_label | default: "ETA" }}</span>
            <span class="quiz-chart-stat-value" id="chartEta"></span>
          </div>
        </div>
        <div class="quiz-chart-svg-wrap" id="quizChartWrap"></div>
      </div>
      <button class="quiz-btn quiz-btn--cta" onclick="quizNext(17)">{{ section.settings.step16_button | default: "GET MY PROTOCOL" }} &rarr;</button>
    </div>

    <!-- STEP 17: Claim -->
    <div class="quiz-step" data-step="17">
      <h2 class="quiz-heading">{{ section.settings.step17_heading | default: "YOU'LL RECLAIM YOUR ENERGY & DRIVE WITH JUST A 90-DAY SUPPLY FROM CHAD BITES" }}</h2>
      <p class="quiz-subtext">{{ section.settings.step17_body | default: "Because you qualify, we guarantee you'll achieve all your goals with a 90-day supply of our Natural T-Optimization System. If not, you'll receive a full refund — no questions asked." }}</p>
      <div class="quiz-square-image" style="margin: 24px auto;">
        {% if section.settings.step17_image != blank %}
          <img src="{{ section.settings.step17_image | image_url: width: 600 }}" alt="" loading="lazy" style="width:100%;height:100%;object-fit:cover;border-radius:12px;">
        {% else %}
          <div style="width:100%;height:100%;background:linear-gradient(135deg,#4d7cfe,#7c3aed);border-radius:12px;display:flex;align-items:center;justify-content:center;">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1" style="color:rgba(255,255,255,0.3)"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          </div>
        {% endif %}
      </div>
      <button class="quiz-btn quiz-btn--cta" onclick="quizNext(18)">{{ section.settings.step17_button | default: "GET 1 MONTH FREE" }} &rarr;</button>
    </div>

    <!-- STEP 18: Animated discount sequence -->
    <div class="quiz-step" data-step="18">
      <h2 class="quiz-heading">{{ section.settings.step18_heading | default: "APPLYING YOUR DISCOUNT…" }}</h2>
      <p class="quiz-subtext">{{ section.settings.step18_subtext | default: "Securing your 90-day protocol and loading your personalized offer." }}</p>
      <div class="quiz-checklist" id="step18Checklist">
        {%- assign step18_items = section.settings.step18_checklist | default: "Verifying your eligibility|Locking in your 90-day protocol|Activating your money-back guarantee|Loading your personalized offer" | split: "|" -%}
        {%- for item in step18_items -%}
          <div class="quiz-check-item"><span class="quiz-check-icon">&#x2713;</span> {{ item }}</div>
        {%- endfor -%}
      </div>
      <p class="quiz-final-text" id="step18Final" style="display:none;">{{ section.settings.step18_final | default: "PLEASE DON'T REFRESH — YOUR DISCOUNT IS BEING APPLIED" }}</p>
    </div>

  </div>
</section>

<style>
  .quiz-section {
    background: #0a0b14;
    min-height: 100vh;
    padding: 0 0 60px;
    font-family: 'Inter', sans-serif;
    color: #fff;
    position: relative;
  }
  .quiz-progress-bar {
    position: fixed;
    top: 64px;
    left: 0;
    width: 100%;
    height: 4px;
    background: rgba(255,255,255,0.08);
    z-index: 1003;
  }
  .quiz-progress-fill {
    height: 100%;
    width: 6.25%;
    background: linear-gradient(90deg, #4d7cfe, #7c3aed);
    transition: width 0.4s ease;
  }
  .quiz-progress-text {
    text-align: center;
    padding: 40px 0 8px;
    font-size: 13px;
    color: rgba(255,255,255,0.4);
    letter-spacing: 1px;
    font-family: 'Inter', sans-serif;
  }
  .quiz-container {
    max-width: 600px;
    margin: 0 auto;
    padding: 16px 20px 0;
    position: relative;
  }
  .quiz-step {
    display: none;
    opacity: 0;
    transition: opacity 0.35s ease;
    text-align: center;
  }
  .quiz-step--active {
    display: block;
    opacity: 1;
  }
  .quiz-heading {
    font-family: 'Orbitron', sans-serif;
    font-size: 22px;
    font-weight: 700;
    line-height: 1.4;
    margin: 20px 0 16px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }
  .quiz-subtext {
    font-size: 15px;
    color: rgba(255,255,255,0.6);
    line-height: 1.6;
    margin-bottom: 28px;
  }
  .quiz-body {
    font-size: 16px;
    color: rgba(255,255,255,0.75);
    line-height: 1.7;
    margin-bottom: 28px;
  }

  /* Circle image - Step 1 */
  .quiz-circle-image {
    width: 280px;
    height: 280px;
    border-radius: 50%;
    background: linear-gradient(135deg, #4d7cfe, #7c3aed);
    margin: 24px auto;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .quiz-circle-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Square image - Step 8 */
  .quiz-square-image {
    width: 300px;
    height: 300px;
    border-radius: 12px;
    background: linear-gradient(135deg, #4d7cfe, #7c3aed);
    margin: 24px auto;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .quiz-square-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Options (frosted glass) */
  .quiz-options {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 8px;
  }
  .quiz-option {
    width: 100%;
    padding: 16px 20px;
    background: rgba(255,255,255,0.06);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 10px;
    color: #fff;
    font-size: 15px;
    font-family: 'Inter', sans-serif;
    cursor: pointer;
    text-align: left;
    transition: border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }
  .quiz-option:hover {
    border-color: rgba(77,124,254,0.3);
    background: rgba(255,255,255,0.09);
    box-shadow: 0 0 20px rgba(77,124,254,0.1);
  }
  .quiz-option:active {
    background: rgba(77,124,254,0.15);
    border-color: rgba(77,124,254,0.5);
  }

  /* CTA Buttons */
  .quiz-btn--cta {
    display: inline-block;
    width: 100%;
    padding: 16px 32px;
    background: linear-gradient(135deg, #4d7cfe, #7c3aed);
    border: none;
    border-radius: 10px;
    color: #fff;
    font-size: 16px;
    font-weight: 600;
    font-family: 'Orbitron', sans-serif;
    cursor: pointer;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-decoration: none;
    text-align: center;
    transition: opacity 0.2s ease, transform 0.2s ease;
    margin-top: 12px;
  }
  .quiz-btn--cta:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  /* Info box (steps 12, 13) */
  .quiz-info-box {
    background: rgba(77,124,254,0.08);
    border: 1px solid rgba(77,124,254,0.2);
    border-radius: 10px;
    padding: 16px 20px;
    margin-bottom: 20px;
    text-align: left;
  }
  .quiz-info-heading {
    font-family: 'Orbitron', sans-serif;
    font-size: 12px;
    color: #4d7cfe;
    letter-spacing: 2px;
    margin: 0 0 8px;
  }
  .quiz-info-text {
    font-size: 14px;
    color: rgba(255,255,255,0.6);
    line-height: 1.6;
    margin: 0;
  }

  /* Step 11: Analysis bar */
  .quiz-analysis-bar-wrap {
    margin: 40px 0 20px;
  }
  .quiz-analysis-bar {
    width: 100%;
    height: 6px;
    background: rgba(255,255,255,0.08);
    border-radius: 3px;
    overflow: hidden;
  }
  .quiz-analysis-bar-fill {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, #4d7cfe, #7c3aed);
    border-radius: 3px;
    transition: width 0.1s linear;
  }
  .quiz-analysis-label {
    display: block;
    margin-top: 12px;
    font-size: 12px;
    letter-spacing: 3px;
    color: rgba(255,255,255,0.4);
    font-family: 'Orbitron', sans-serif;
  }

  /* Step 14: Checklist */
  .quiz-checklist {
    text-align: left;
    margin: 32px 0 20px;
  }
  .quiz-check-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 0;
    font-size: 15px;
    color: rgba(255,255,255,0.7);
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.4s ease, transform 0.4s ease;
  }
  .quiz-check-item--visible {
    opacity: 1;
    transform: translateY(0);
  }
  .quiz-check-icon {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: linear-gradient(135deg, #4d7cfe, #7c3aed);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    color: #fff;
    flex-shrink: 0;
  }
  .quiz-ready-text {
    font-family: 'Orbitron', sans-serif;
    font-size: 14px;
    color: #4d7cfe;
    letter-spacing: 1px;
    margin-top: 24px;
    opacity: 0;
    transition: opacity 0.5s ease;
  }
  .quiz-ready-text--visible {
    opacity: 1;
  }

  /* Step 15: Results */
  .quiz-result-label {
    font-family: 'Orbitron', sans-serif;
    font-size: 28px;
    font-weight: 700;
    color: #4d7cfe;
    margin: 8px 0 16px;
    letter-spacing: 2px;
  }
  .quiz-result-desc {
    font-size: 15px;
    color: rgba(255,255,255,0.65);
    line-height: 1.7;
    margin-bottom: 28px;
  }
  .quiz-suppression-wrap {
    margin-bottom: 28px;
    text-align: left;
  }
  .quiz-suppression-label {
    font-size: 12px;
    letter-spacing: 2px;
    color: rgba(255,255,255,0.4);
    font-family: 'Orbitron', sans-serif;
    display: block;
    margin-bottom: 10px;
  }
  .quiz-suppression-bar {
    width: 100%;
    height: 10px;
    background: rgba(255,255,255,0.08);
    border-radius: 5px;
    overflow: hidden;
  }
  .quiz-suppression-fill {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, #4d7cfe, #e74c3c);
    border-radius: 5px;
    transition: width 1s ease;
  }
  .quiz-stat-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-bottom: 28px;
  }
  .quiz-stat-card {
    background: rgba(255,255,255,0.06);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 10px;
    padding: 16px;
    text-align: left;
  }
  .quiz-stat-title {
    display: block;
    font-size: 10px;
    letter-spacing: 1.5px;
    color: rgba(255,255,255,0.4);
    font-family: 'Orbitron', sans-serif;
    margin-bottom: 8px;
  }
  .quiz-stat-value {
    display: block;
    font-size: 14px;
    font-weight: 600;
    color: #4d7cfe;
    font-family: 'Orbitron', sans-serif;
  }

  /* Step 16: Chart */
  .quiz-chart-card {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 12px;
    padding: 24px 20px;
    margin-bottom: 28px;
  }
  .quiz-chart-stats {
    display: flex;
    justify-content: space-between;
    margin-bottom: 20px;
    gap: 8px;
  }
  .quiz-chart-stat {
    text-align: center;
    flex: 1;
  }
  .quiz-chart-stat-label {
    display: block;
    font-size: 10px;
    letter-spacing: 1.5px;
    color: rgba(255,255,255,0.4);
    font-family: 'Orbitron', sans-serif;
    margin-bottom: 6px;
  }
  .quiz-chart-stat-value {
    display: block;
    font-size: 14px;
    font-weight: 700;
    color: #4d7cfe;
    font-family: 'Orbitron', sans-serif;
  }
  .quiz-chart-svg-wrap svg {
    width: 100%;
    height: auto;
  }

  /* Mobile */
  @media (max-width: 480px) {
    .quiz-heading {
      font-size: 18px;
    }
    .quiz-circle-image {
      width: 220px;
      height: 220px;
    }
    .quiz-square-image {
      width: 240px;
      height: 240px;
    }
    .quiz-stat-grid {
      grid-template-columns: 1fr 1fr;
      gap: 8px;
    }
    .quiz-stat-card {
      padding: 12px;
    }
    .quiz-stat-title {
      font-size: 9px;
    }
    .quiz-stat-value {
      font-size: 12px;
    }
    .quiz-chart-stats {
      flex-direction: row;
      flex-wrap: wrap;
    }
    .quiz-result-label {
      font-size: 22px;
    }
  }
</style>

<script>
  (function() {
    var quizScores = {};
    var currentStep = 1;
    var totalSteps = 18;

    /* Scoring map: step -> key name, and step -> [score per answer index]
       Answer index 0 = first option in pipe-separated list.
       Steps with no scoring (3, 7) use null. */
    var scoreMap = {
      2:  { key: 'age',    scores: [4, 3, 2, 1] },
      3:  { key: 'concern', scores: null },
      4:  { key: 'stress', scores: [2, 0] },
      5:  { key: 'energy', scores: [3, 2, 1, 0] },
      6:  { key: 'when',   scores: [3, 2, 1, 1] },
      7:  { key: 'expected', scores: null },
      9:  { key: 'body',   scores: [0, 1, 2, 3] },
      10: { key: 'sleep',  scores: [3, 2, 1, 0] },
      12: { key: 'family', scores: [2, 0, 1] },
      13: { key: 'diet',   scores: [3, 2, 1, 0] }
    };

    window.quizSelectAnswer = function(step, answerIndex, btnEl) {
      var mapping = scoreMap[step];
      if (mapping && mapping.key) {
        var score = 0;
        if (mapping.scores && answerIndex < mapping.scores.length) {
          score = mapping.scores[answerIndex];
        }
        quizScores[mapping.key] = score;
      }
      quizNext(step + 1);
    };

    window.quizNext = function(nextStep) {
      var current = document.querySelector('.quiz-step--active');
      if (current) {
        current.style.opacity = '0';
        setTimeout(function() {
          current.classList.remove('quiz-step--active');
          current.style.display = 'none';
          showStep(nextStep);
        }, 300);
      } else {
        showStep(nextStep);
      }
    };

    function showStep(step) {
      currentStep = step;
      var el = document.querySelector('[data-step="' + step + '"]');
      if (!el) return;
      el.style.display = 'block';
      el.style.opacity = '0';
      el.classList.add('quiz-step--active');
      setTimeout(function() { el.style.opacity = '1'; }, 30);

      // Update progress
      var pct = (step / totalSteps) * 100;
      document.getElementById('quizProgressFill').style.width = pct + '%';
      document.getElementById('quizProgressText').textContent = step + ' / ' + totalSteps;

      // Step 11: animated analysis
      if (step === 11) { runAnalysisAnimation(); }
      // Step 14: checklist animation
      if (step === 14) { runChecklistAnimation(); }

      if (step === 18) {
        var items18 = document.querySelectorAll('#step18Checklist .quiz-check-item');
        items18.forEach(function(el) { el.style.opacity = '0'; el.style.transform = 'translateX(-10px)'; el.style.transition = 'opacity 0.4s ease, transform 0.4s ease'; });
        items18.forEach(function(el, idx) {
          setTimeout(function() { el.style.opacity = '1'; el.style.transform = 'translateX(0)'; }, (idx + 1) * 1000);
        });
        setTimeout(function() {
          document.getElementById('step18Final').style.display = 'block';
        }, (items18.length + 1) * 1000);
        setTimeout(function() {
          var url = document.getElementById('quiz-section').getAttribute('data-redirect-url');
          if (url && url !== '#' && url !== '') { window.location.href = url; }
        }, (items18.length + 2) * 1000);
      }
      // Step 15: compute results
      if (step === 15) { computeResults(); }
      // Step 16: render chart
      if (step === 16) { renderChart(); }

      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function runAnalysisAnimation() {
      var bar = document.getElementById('analysisBarFill');
      bar.style.width = '0%';
      var pct = 0;
      var interval = setInterval(function() {
        pct += 2.5;
        if (pct > 100) pct = 100;
        bar.style.width = pct + '%';
        if (pct >= 100) {
          clearInterval(interval);
          setTimeout(function() { quizNext(12); }, 400);
        }
      }, 100);
    }

    function runChecklistAnimation() {
      var checklist = document.getElementById('quizChecklist');
      var items = checklist.querySelectorAll('.quiz-check-item');
      for (var i = 0; i < items.length; i++) {
        items[i].classList.remove('quiz-check-item--visible');
      }
      document.getElementById('quizReadyText').classList.remove('quiz-ready-text--visible');

      for (var j = 0; j < items.length; j++) {
        (function(idx) {
          setTimeout(function() {
            items[idx].classList.add('quiz-check-item--visible');
          }, (idx + 1) * 1000);
        })(j);
      }
      setTimeout(function() {
        document.getElementById('quizReadyText').classList.add('quiz-ready-text--visible');
      }, (items.length + 1) * 1000);
      setTimeout(function() {
        quizNext(15);
      }, (items.length + 2) * 1000);
    }

    function getResultData() {
      var total = 0;
      var keys = ['age','stress','energy','when','body','sleep','family','diet'];
      for (var i = 0; i < keys.length; i++) {
        total += (quizScores[keys[i]] || 0);
      }

      var data = {};
      if (total >= 15) {
        data.level = 'ADVANCED DECLINE';
        data.suppression = 85;
        data.projected = 40;
        data.quality = 'SEVERE';
        data.desc = 'Hormonal function has significantly declined. Adipose tissue, chronic stress, and lifestyle factors are actively suppressing your testosterone production.';
      } else if (total >= 10) {
        data.level = 'MODERATE DECLINE';
        data.suppression = 65;
        data.projected = 35;
        data.quality = 'HIGH';
        data.desc = 'Multiple lifestyle factors are compounding to reduce your natural testosterone output. Your body\'s hormonal recovery system is under significant strain.';
      } else if (total >= 5) {
        data.level = 'EARLY DECLINE';
        data.suppression = 45;
        data.projected = 30;
        data.quality = 'MEDIUM';
        data.desc = 'Adipose tissue is starting to convert testosterone into estrogen, slowing your hormonal recovery.';
      } else {
        data.level = 'INITIAL SIGNS';
        data.suppression = 25;
        data.projected = 25;
        data.quality = 'LOW';
        data.desc = 'Early hormonal shifts detected. Catching this now gives you a significant advantage in maintaining peak testosterone levels.';
      }

      // Root causes
      var primary = 'AROMATASE LOAD';
      var secondary = 'CHRONIC STRESS';
      var stressScore = quizScores.stress || 0;
      var sleepScore = quizScores.sleep || 0;
      var dietScore = quizScores.diet || 0;
      var bodyScore = quizScores.body || 0;

      var maxCat = Math.max(stressScore, sleepScore, dietScore, bodyScore);
      if (maxCat === stressScore && stressScore > 0) { primary = 'CHRONIC STRESS'; }
      else if (maxCat === sleepScore && sleepScore > 0) { primary = 'SLEEP DEBT'; }
      else if (maxCat === dietScore && dietScore > 0) { primary = 'AROMATASE LOAD'; }
      else if (maxCat === bodyScore && bodyScore > 0) { primary = 'EXCESS ADIPOSE'; }

      // Secondary: pick second highest
      var cats = [
        { name: 'CHRONIC STRESS', score: stressScore },
        { name: 'SLEEP DEBT', score: sleepScore },
        { name: 'AROMATASE LOAD', score: dietScore },
        { name: 'EXCESS ADIPOSE', score: bodyScore }
      ];
      cats.sort(function(a, b) { return b.score - a.score; });
      secondary = cats[0].name === primary ? cats[1].name : cats[0].name;
      if (secondary === primary) secondary = cats[1].name;

      data.primary = primary;
      data.secondary = secondary;
      data.total = total;
      return data;
    }

    function computeResults() {
      var d = getResultData();
      document.getElementById('resultDeclineLabel').textContent = d.level;
      document.getElementById('resultDescription').textContent = d.desc;
      setTimeout(function() {
        document.getElementById('resultSuppressionFill').style.width = d.suppression + '%';
      }, 100);
      document.getElementById('statDecline').textContent = d.level;
      document.getElementById('statPrimary').textContent = d.primary;
      document.getElementById('statSecondary').textContent = d.secondary;
      document.getElementById('statQuality').textContent = d.quality;
    }

    function renderChart() {
      var d = getResultData();
      var etaDate = new Date(Date.now() + 90 * 24 * 60 * 60 * 1000);
      var months = ['January','February','March','April','May','June','July','August','September','October','November','December'];
      var etaStr = months[etaDate.getMonth()] + ' ' + etaDate.getDate() + ', ' + etaDate.getFullYear();

      // Update step 16 date span
      document.getElementById('step16Date').textContent = etaStr;

      document.getElementById('chartStatus').textContent = d.level;
      document.getElementById('chartLift').textContent = '+' + d.projected + '%';
      document.getElementById('chartEta').textContent = etaStr;

      // Generate month labels
      var now = new Date();
      var m0 = months[now.getMonth()].substring(0, 3).toUpperCase();
      var m1 = months[(now.getMonth() + 1) % 12].substring(0, 3).toUpperCase();
      var m2 = months[(now.getMonth() + 2) % 12].substring(0, 3).toUpperCase();
      var m3 = months[(now.getMonth() + 3) % 12].substring(0, 3).toUpperCase();

      // Starting Y position based on score
      var startY = d.total >= 10 ? 160 : (d.total >= 5 ? 130 : 100);
      var endY = 40;

      var svgNs = 'http://www.w3.org/2000/svg';
      var svg = document.createElementNS(svgNs, 'svg');
      svg.setAttribute('viewBox', '0 0 520 220');
      svg.setAttribute('width', '100%');
      svg.setAttribute('height', '220');

      // Defs for gradient
      var defs = document.createElementNS(svgNs, 'defs');
      var lg = document.createElementNS(svgNs, 'linearGradient');
      lg.setAttribute('id', 'chartGrad');
      lg.setAttribute('x1', '0'); lg.setAttribute('y1', '0');
      lg.setAttribute('x2', '0'); lg.setAttribute('y2', '1');
      var s1 = document.createElementNS(svgNs, 'stop');
      s1.setAttribute('offset', '0%'); s1.setAttribute('stop-color', '#4d7cfe'); s1.setAttribute('stop-opacity', '0.3');
      var s2 = document.createElementNS(svgNs, 'stop');
      s2.setAttribute('offset', '100%'); s2.setAttribute('stop-color', '#4d7cfe'); s2.setAttribute('stop-opacity', '0');
      lg.appendChild(s1); lg.appendChild(s2); defs.appendChild(lg);
      svg.appendChild(defs);

      // Y-axis labels
      var yLabels = [
        { text: 'HIGH T-LEVEL', y: 40 },
        { text: 'NORMAL T-LEVEL', y: 100 },
        { text: 'LOW T-LEVEL', y: 160 }
      ];
      for (var i = 0; i < yLabels.length; i++) {
        var line = document.createElementNS(svgNs, 'line');
        line.setAttribute('x1', '110'); line.setAttribute('y1', yLabels[i].y);
        line.setAttribute('x2', '500'); line.setAttribute('y2', yLabels[i].y);
        line.setAttribute('stroke', 'rgba(255,255,255,0.06)'); line.setAttribute('stroke-width', '1');
        svg.appendChild(line);
        var txt = document.createElementNS(svgNs, 'text');
        txt.setAttribute('x', '5'); txt.setAttribute('y', yLabels[i].y + 4);
        txt.setAttribute('fill', 'rgba(255,255,255,0.3)');
        txt.setAttribute('font-size', '9'); txt.setAttribute('font-family', 'Orbitron, sans-serif');
        txt.textContent = yLabels[i].text;
        svg.appendChild(txt);
      }

      // X-axis labels
      var xPositions = [140, 260, 380, 490];
      var xLabels = ['TODAY', m1, m2, m3];
      for (var j = 0; j < xLabels.length; j++) {
        var xt = document.createElementNS(svgNs, 'text');
        xt.setAttribute('x', xPositions[j]); xt.setAttribute('y', 195);
        xt.setAttribute('fill', 'rgba(255,255,255,0.3)'); xt.setAttribute('text-anchor', 'middle');
        xt.setAttribute('font-size', '10'); xt.setAttribute('font-family', 'Orbitron, sans-serif');
        xt.textContent = xLabels[j];
        svg.appendChild(xt);
      }

      // Curve path
      var cp1x = 220, cp1y = startY - 10;
      var cp2x = 360, cp2y = endY + 20;
      var pathD = 'M 140 ' + startY + ' C ' + cp1x + ' ' + cp1y + ' ' + cp2x + ' ' + cp2y + ' 490 ' + endY;

      // Fill area
      var areaD = pathD + ' L 490 180 L 140 180 Z';
      var area = document.createElementNS(svgNs, 'path');
      area.setAttribute('d', areaD);
      area.setAttribute('fill', 'url(#chartGrad)');
      svg.appendChild(area);

      // Curve line
      var curveLine = document.createElementNS(svgNs, 'path');
      curveLine.setAttribute('d', pathD);
      curveLine.setAttribute('stroke', '#4d7cfe'); curveLine.setAttribute('stroke-width', '3');
      curveLine.setAttribute('fill', 'none'); curveLine.setAttribute('stroke-linecap', 'round');
      svg.appendChild(curveLine);

      // Start dot
      var dot1 = document.createElementNS(svgNs, 'circle');
      dot1.setAttribute('cx', '140'); dot1.setAttribute('cy', startY);
      dot1.setAttribute('r', '5'); dot1.setAttribute('fill', '#4d7cfe');
      svg.appendChild(dot1);

      // "YOU ARE HERE" label
      var youLabel = document.createElementNS(svgNs, 'text');
      youLabel.setAttribute('x', '140'); youLabel.setAttribute('y', startY + 20);
      youLabel.setAttribute('fill', 'rgba(255,255,255,0.5)'); youLabel.setAttribute('text-anchor', 'middle');
      youLabel.setAttribute('font-size', '8'); youLabel.setAttribute('font-family', 'Orbitron, sans-serif');
      youLabel.textContent = 'YOU ARE HERE';
      svg.appendChild(youLabel);

      // End dot
      var dot2 = document.createElementNS(svgNs, 'circle');
      dot2.setAttribute('cx', '490'); dot2.setAttribute('cy', endY);
      dot2.setAttribute('r', '5'); dot2.setAttribute('fill', '#4d7cfe');
      svg.appendChild(dot2);

      // "GOAL" label
      var goalLabel = document.createElementNS(svgNs, 'text');
      goalLabel.setAttribute('x', '490'); goalLabel.setAttribute('y', endY - 12);
      goalLabel.setAttribute('fill', '#4d7cfe'); goalLabel.setAttribute('text-anchor', 'middle');
      goalLabel.setAttribute('font-size', '9'); goalLabel.setAttribute('font-family', 'Orbitron, sans-serif');
      goalLabel.setAttribute('font-weight', '700');
      goalLabel.textContent = 'GOAL \u2022 +' + d.projected + '% T';
      svg.appendChild(goalLabel);

      document.getElementById('quizChartWrap').innerHTML = '';
      document.getElementById('quizChartWrap').appendChild(svg);
    }
  })();
</script>

