<section class="problems-section section-padding" data-section-id="{{ section.id }}">
  <div class="container">
    <div class="problems-layout">
      <div class="problems-text">
        <h2 class="section-heading">{{ section.settings.heading }}</h2>
        {% if section.settings.subtext != blank %}
          <p class="problems-desc">{{ section.settings.subtext }}</p>
        {% endif %}
        {% if section.settings.cta_text != blank %}
          <a href="{{ section.settings.cta_url | default: '#' }}" class="btn btn-outline">
            {{ section.settings.cta_text }}
          </a>
        {% endif %}
      </div>

      <div class="problems-grid">
        {% for block in section.blocks %}
          {% if block.type == 'problem' %}
            <div class="problem-card glass-card" {{ block.shopify_attributes }}>
              <div class="problem-card-img">
                {% if block.settings.image != blank %}
                  <img src="{{ block.settings.image | image_url: width: 400 }}" alt="{{ block.settings.title }}" loading="lazy">
                {% else %}
                  {% case block.settings.icon %}
                    {% when 'stress' %}
                      <img src="{{ 'problem-stress.jpg' | asset_url }}" alt="{{ block.settings.title }}" loading="lazy">
                    {% when 'sleep' %}
                      <img src="{{ 'problem-sleep.jpg' | asset_url }}" alt="{{ block.settings.title }}" loading="lazy">
                    {% when 'food' %}
                      <img src="{{ 'problem-food.jpg' | asset_url }}" alt="{{ block.settings.title }}" loading="lazy">
                    {% when 'screens' %}
                      <img src="{{ 'problem-screens.jpg' | asset_url }}" alt="{{ block.settings.title }}" loading="lazy">
                  {% endcase %}
                {% endif %}
              </div>
              <div class="problem-card-body">
                <div class="problem-card-icon">
                  {% case block.settings.icon %}
                    {% when 'stress' %}
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                    {% when 'sleep' %}
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
                    {% when 'food' %}
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M3 12a9 9 0 1118 0 9 9 0 01-18 0z"/></svg>
                    {% when 'screens' %}
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                    {% else %}
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                  {% endcase %}
                </div>
                <h3>{{ block.settings.title }}</h3>
                <p>{{ block.settings.description }}</p>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Problems",
  "class": "problems-section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "MODERN LIFE IS WORKING AGAINST MEN"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Description",
      "default": "Everyday stressors, poor habits, and environmental toxins are silently lowering your testosterone and holding you back."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA button text",
      "default": "TAKE BACK CONTROL"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA button link"
    }
  ],
  "blocks": [
    {
      "type": "problem",
      "name": "Problem card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Problem"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Description of the problem affecting men today."
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "stress", "label": "Stress (lightning)" },
            { "value": "sleep", "label": "Sleep (moon)" },
            { "value": "food", "label": "Food (warning)" },
            { "value": "screens", "label": "Screens (monitor)" }
          ],
          "default": "stress"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card image (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Problems",
      "blocks": [
        { "type": "problem", "settings": { "title": "Chronic Stress", "description": "Elevated cortisol destroys testosterone and drains your drive.", "icon": "stress" } },
        { "type": "problem", "settings": { "title": "Poor Sleep", "description": "Interrupted sleep reduces testosterone and slows recovery.", "icon": "sleep" } },
        { "type": "problem", "settings": { "title": "Processed Foods", "description": "Poor nutrition spikes inflammation and kills vitality.", "icon": "food" } },
        { "type": "problem", "settings": { "title": "Endless Screens", "description": "Blue light and constant stimulation wrecks focus and hormone health.", "icon": "screens" } }
      ]
    }
  ]
}
{% endschema %}
