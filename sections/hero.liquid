<section class="hero-section" data-section-id="{{ section.id }}">
  <div class="hero-bg">
    {% if section.settings.background_image != blank %}
      <img src="{{ section.settings.background_image | image_url: width: 1920 }}"
           alt="" loading="eager" fetchpriority="high">
    {% else %}
      <img src="{{ 'hero-bg.jpg' | asset_url }}"
           alt="" loading="eager" fetchpriority="high">
    {% endif %}
  </div>

  <div class="hero-inner">
    <div class="hero-image-col">
      <div class="hero-main-image">
        {% if section.settings.hero_image != blank %}
          <img src="{{ section.settings.hero_image | image_url: width: 800 }}" alt="" loading="eager">
        {% else %}
          <div class="hero-image-placeholder">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          </div>
        {% endif %}
      </div>
    </div>

    <div class="hero-text">
      <h1 class="hero-heading">{{ section.settings.heading }}</h1>
      <p class="hero-subtext">{{ section.settings.subtext }}</p>
      <div class="hero-actions">
        <a href="{{ section.settings.cta_url | default: '#' }}" class="btn btn-primary btn-lg">
          {{ section.settings.cta_text | default: "GET 1 BOTTLE FREE" }}
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
        </a>
      </div>
      {% if section.settings.badges_image != blank %}
      <div class="hero-badges">
        <img src="{{ section.settings.badges_image | image_url: width: 640 }}" alt="Trust badges" loading="eager">
      </div>
      {% elsif section.settings.badges_url != blank %}
      <div class="hero-badges">
        <img src="{{ section.settings.badges_url }}" alt="Trust badges" loading="eager">
      </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "class": "hero-section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "AMERICA'S #1 TESTOSTERONE BOOSTER GUMMY"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "8 science-backed ingredients in one daily gummy. Try it for 90 days. Higher T or your money back."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button text",
      "default": "GET 1 BOTTLE FREE"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image (square)"
    },
    {
      "type": "image_picker",
      "id": "badges_image",
      "label": "Trust badges image"
    },
    {
      "type": "text",
      "id": "badges_url",
      "label": "Trust badges image URL (fallback)",
      "default": "https://cdn.shopify.com/s/files/1/0896/0851/9991/files/badges-removebg.png?v=1771042099"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
