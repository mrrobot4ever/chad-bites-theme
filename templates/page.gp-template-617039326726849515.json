        "ggG0HMCIQbM_text": "<span style=\"color:#000000;font-size:30px;\">OVER </span><span style=\"color:#FF2001;font-size:30px;\">36,491+ MEN</span><span style=\"color:#000000;font-size:30px;\"> HAVE RECLAIMED THEIR TESTOSTERONE</span>",
