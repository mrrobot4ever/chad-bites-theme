        "ggB6uF7t7xs_text": "US <span style=\"color:#FFFFFF;\">VS</span> <span style=\"color:#FFFFFF;\">THEM</span>",
        "ggFTGO4TLao_text": "<p>CONVENIENCE</p>",
        "ggGEcUZaVaa_text": "<p><span style=\"background-color:rgb(216,177,90);color:#0F0808;font-size:14px;\"><strong>Supports Natural Production</strong></span></p>",
        "ggGaFiztoYs_text": "<p>BODY'S PRODUCTION</p>",
        "ggIZ1FW_6Vc_text": "<p><span style=\"background-color:rgb(216,177,90);color:#070505;font-size:14px;\"><strong>Take at Home</strong></span></p>",
        "ggLZ27ciT4O_text": "<p><span style=\"font-size:14px;\"><strong>Significant Risks</strong></span></p>",
        "ggLkC4IvAmJ_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0896/0851/9991/files/wo-syringe.webp",
        "ggLkC4IvAmJ_srcSet_mobile_src": "https://cdn.shopify.com/s/files/1/0896/0851/9991/files/wo-syringe.webp",
        "ggPoavTVNEX_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0896/0851/9991/files/wo-1Bottle-Trans.webp",
        "ggPoavTVNEX_srcSet_mobile_src": "https://cdn.shopify.com/s/files/1/0896/0851/9991/files/wo-1Bottle-Trans.webp",
        "ggTQcPR5a_3_text": "<p><span style=\"font-size:15px;\"><strong>Natural Testosterone Support is not your typical T Booster. It's a next-generation and natural formula designed to support hormone optimization without the risks and commitment of TRT.</strong></span></p>",
        "ggThFZ8TIKC_text": "<p><span style=\"background-color:rgb(216,177,90);color:#0F0A0A;font-size:14px;\"><strong>~$40 per Month</strong></span></p>",
        "ggTxxK3ZahN_text": "<p>APPROACH</p>",
        "ggUqSmXmA-N_text": "<p><span style=\"font-size:14px;\"><strong>&nbsp;~$250 per Month&nbsp;</strong></span></p>",
        "gge0YkEIEN__text": "<p><span style=\"font-size:14px;\"><strong>Shuts Down Natural Production</strong></span></p>",
        "ggk_q4nMdyK_text": "<p>COMMITMENT</p>",
        "ggldwaIPrVo_text": "<span style=\"color:#D8B15A;font-size:32px;\"><strong>The Chad Bites Difference</strong></span>",
        "ggo4oDR1joH_text": "<p>SIDE EFFECTS</p>",
        "ggt1VtXbjmG_text": "<p><span style=\"background-color:rgb(216,177,90);color:#020101;font-size:14px;\"><strong>Optional Testing</strong></span></p>",
        "ggt2_Ua4E0A_text": "<p><span style=\"background-color:rgb(216,177,90);color:#0A0707;font-size:14px;\"><strong>Minimal Risk</strong></span></p>",
        "ggvNSCWqRhB_text": "<p><span style=\"font-size:14px;\"><strong>Lifelong Dependency</strong></span></p>",
        "ggwPDa7JFtp_text": "<p><span style=\"font-size:14px;\"><strong>Required Bloodwork</strong></span></p>",
        "ggwpjOxwn1V_text": "<p>MONITORING</p>",
        "ggy21AOuGN0_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0896/0851/9991/files/wo-WallenTireflip.webp",
        "ggz6bu4HJ1q_text": "<p><span style=\"background-color:rgb(216,177,90);color:#070404;font-size:14px;\"><strong>Natural Support</strong></span></p>"
